<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xUnit v3 analyzer: tests pass their own tokens where it matters. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hoshi.App\Hoshi.App.csproj" />
    <ProjectReference Include="..\..\src\Hoshi.Engines\Hoshi.Engines.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Hoshi.Sgf.Tests\Samples\variations.sgf" Link="Samples\variations.sgf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
