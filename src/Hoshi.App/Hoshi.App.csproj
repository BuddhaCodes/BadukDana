<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Hoshi's UI and services, shared by the desktop app (Hoshi.Desktop) and Android (Hoshi.Android). -->
    <RootNamespace>Hoshi.App</RootNamespace>
    <AssemblyName>Hoshi.App</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\katago\**" />
    <EmbeddedResource Include="Joseki\starter.sgf" LogicalName="Hoshi.Joseki.starter.sgf" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Also inside the assembly, for platforms without files next to the app (Android). -->
    <EmbeddedResource Include="appsettings.json" LogicalName="Hoshi.appsettings.json" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoshi.Core\Hoshi.Core.csproj" />
    <ProjectReference Include="..\Hoshi.Sgf\Hoshi.Sgf.csproj" />
    <ProjectReference Include="..\Hoshi.Ogs\Hoshi.Ogs.csproj" />
    <ProjectReference Include="..\Hoshi.Engines\Hoshi.Engines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hoshi.App.Tests" />
  </ItemGroup>
</Project>
