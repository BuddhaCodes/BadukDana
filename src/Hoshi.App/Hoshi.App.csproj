<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Hoshi.App</RootNamespace>
    <AssemblyName>Hoshi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hoshi.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\katago\**" />
    <!-- A local KataGo dropped in Assets/katago (not in git) is copied next to the app, where Hoshi finds it as "bundled". -->
    <None Include="Assets\katago\**" Exclude="Assets\katago\analysis_logs\**;Assets\katago\gtp_logs\**" Condition="Exists('Assets\katago')"
          Link="katago\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Joseki\starter.sgf" LogicalName="Hoshi.Joseki.starter.sgf" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
    <!-- Direct reference only to lift the transitive version (see Directory.Packages.props). -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoshi.Core\Hoshi.Core.csproj" />
    <ProjectReference Include="..\Hoshi.Sgf\Hoshi.Sgf.csproj" />
    <ProjectReference Include="..\Hoshi.Ogs\Hoshi.Ogs.csproj" />
    <ProjectReference Include="..\Hoshi.Engines\Hoshi.Engines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hoshi.App.Tests" />
  </ItemGroup>
</Project>
