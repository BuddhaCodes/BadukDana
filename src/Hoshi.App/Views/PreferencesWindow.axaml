<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hoshi.App.ViewModels"
        xmlns:c="using:Hoshi.App.Controls"
        x:Class="Hoshi.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        x:Name="Root"
        Title="Preferencias"
        Width="760" Height="600" MinWidth="560" MinHeight="460"
        Background="{DynamicResource Bg.Window}"
        WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding #Root.CloseCommand}" />
  </Window.KeyBindings>
  <DockPanel Margin="24,20">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
      <TextBlock Text="星" FontFamily="{DynamicResource Font.Brand}" FontSize="30" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Apariencia" FontFamily="{DynamicResource Font.Title}" FontSize="22" />
        <TextBlock Classes="secondary" Text="El tema se aplica al momento y se recuerda." />
      </StackPanel>
    </StackPanel>

    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Classes="accent" Content="Listo" Command="{Binding #Root.CloseCommand}" Margin="0,12,0,0" />
    <TabControl x:Name="Tabs">
      <TabItem Header="Apariencia">
        <DockPanel Margin="0,10,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <ToggleSwitch IsChecked="{Binding Animations}" OnContent="Animaciones" OffContent="Animaciones" x:Name="AnimationsSwitch" />
            <TextBlock Classes="secondary" Text="Fondo animado y animaciones al colocar piedras. Desactívalas si prefieres una vista quieta." TextWrapping="Wrap" />
          </StackPanel>
        <ListBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Selected}" Background="Transparent" x:Name="ThemeList">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,14,14" />
              <Setter Property="CornerRadius" Value="10" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ThemeCard">
              <Border Classes="theme-card" Classes.selected="{Binding IsSelected}" Width="220">
                <StackPanel>
                  <Panel Height="120" ClipToBounds="True">
                    <c:ThemeBackground Kind="{Binding Theme.Background}" Animate="False" />
                    <c:GoBoardControl Board="{Binding SampleBoard}" BoardStyle="{Binding Theme.Board}" ShowCoordinates="False"
                                      IsInteractive="False" Margin="14" />
                  </Panel>
                  <Border Background="{Binding Chrome}" Padding="12,10">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="9" Height="9" Fill="{Binding Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontFamily="{Binding TitleFont}" FontSize="16" Foreground="#F2F0EA" />
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="#B8B4AC" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Análisis">
        <ScrollViewer Margin="0,10,0,0">
          <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap"
                       Text="Hoshi usa KataGo (libre, MIT) para evaluar cada jugada y estimar el territorio. Descarga en github.com/lightvector/KataGo/releases el paquete de tu sistema (OpenCL para la mayoría de gráficas, CUDA/TensorRT para NVIDIA, Eigen para solo CPU) y una red desde katagotraining.org. El paquete trae analysis_example.cfg." />
            <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
              <Grid.Styles>
                <Style Selector="TextBox"><Setter Property="Margin" Value="0,3" /></Style>
                <Style Selector="Button"><Setter Property="Margin" Value="8,3,0,3" /></Style>
              </Grid.Styles>
              <TextBlock Classes="label" Text="Ejecutable" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding KataGoExecutable}" Watermark="katago.exe" x:Name="ExecutableBox" />
              <Button Grid.Column="2" Content="Examinar…" Command="{Binding BrowseExecutableCommand}" />
              <TextBlock Grid.Row="1" Classes="label" Text="Red neuronal" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KataGoModel}" Watermark="kata1-…bin.gz" />
              <Button Grid.Row="1" Grid.Column="2" Content="Examinar…" Command="{Binding BrowseModelCommand}" />
              <TextBlock Grid.Row="2" Classes="label" Text="Configuración" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KataGoConfig}" Watermark="analysis_example.cfg" />
              <Button Grid.Row="2" Grid.Column="2" Content="Examinar…" Command="{Binding BrowseConfigCommand}" />
              <TextBlock Grid.Row="3" Classes="label" Text="Visitas máximas" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding AnalysisVisits}" Minimum="10" Maximum="100000" Increment="50"
                             FormatString="0" HorizontalAlignment="Left" Width="160" Margin="0,3" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Guardar" Command="{Binding ApplyEngineCommand}" />
              <Button Classes="accent" Content="Probar KataGo" Command="{Binding TestEngineCommand}" IsEnabled="{Binding !IsTesting}" />
            </StackPanel>
            <TextBlock Text="{Binding EngineStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" x:Name="EngineStatus" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="El análisis es en vivo: KataGo muestra resultados parciales enseguida y sigue profundizando en la posición hasta las visitas máximas. Más visitas = más fuerte, pero más uso de la GPU (con una gráfica integrada, 200–500 y una red ligera como b18c384 o b10c128). En partidas de OGS en curso el análisis y el territorio se desactivan: sus normas no permiten ayuda de IA mientras juegas." />

            <TextBlock Classes="label" Text="Celebrar las jugadas fuertes" Margin="0,14,0,0" />
            <CheckBox IsChecked="{Binding MoveEffects}" x:Name="MoveEffectsBox"
                      Content="Sonido e impacto en el tablero cuando KataGo juzga tu jugada como buena, excelente o la mejor" />
            <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding MoveEffects}">
              <TextBlock Text="Volumen" VerticalAlignment="Center" />
              <Slider Minimum="0" Maximum="100" Value="{Binding SoundVolume}" Width="220" x:Name="VolumeSlider" />
              <TextBlock Text="{Binding SoundVolume, StringFormat={}{0} %}" VerticalAlignment="Center" MinWidth="44" />
              <Button Content="Probar sonido" Command="{Binding TestSoundCommand}" />
            </StackPanel>

            <CheckBox IsChecked="{Binding StoneSounds}" x:Name="StoneSoundsBox"
                      Content="Sonido suave al colocar cada piedra (también al avanzar jugada a jugada)" />

            <TextBlock Classes="label" Text="Música adaptativa" Margin="0,14,0,0" />
            <CheckBox IsChecked="{Binding Music}" x:Name="MusicBox"
                      Content="Lo-fi tranquilo que se anima con rachas de buenas jugadas y se calma con el tiempo o con un error (tecla M)" />
            <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding Music}">
              <TextBlock Text="Volumen" VerticalAlignment="Center" />
              <Slider Minimum="0" Maximum="100" Value="{Binding MusicVolume}" Width="220" />
              <TextBlock Text="{Binding MusicVolume, StringFormat={}{0} %}" VerticalAlignment="Center" MinWidth="44" />
            </StackPanel>
            <TextBlock Classes="secondary" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Text="{Binding MusicProblem}"
                       IsVisible="{Binding MusicProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{Binding CustomSoundFolder, StringFormat='Buena: golpe seco · Excelente: explosión con onda expansiva y temblor · La mejor: explosión cinemática, grietas incandescentes y temblor fuerte. Los sonidos son de Hoshi; para usar los tuyos, pon impact_small, explosion_medium o explosion_big (.wav o .mp3) en {0}. El impacto visual necesita las animaciones activadas (Apariencia).'}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
