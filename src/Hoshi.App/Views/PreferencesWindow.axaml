<Window Icon="/Assets/hoshi.ico"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Hoshi.App.Views"
        xmlns:l="using:Hoshi.App.Localization"
        xmlns:vm="using:Hoshi.App.ViewModels"
        xmlns:c="using:Hoshi.App.Controls"
        x:Class="Hoshi.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        x:Name="Root"
        Title="{l:T Prefs.Title}"
        Width="760" Height="600" MinWidth="560" MinHeight="460"
        Background="{DynamicResource Bg.Window}"
        WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding #Root.CloseCommand}" />
  </Window.KeyBindings>
  <v:PreferencesView x:Name="View" />
</Window>
