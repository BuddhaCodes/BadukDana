<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Hoshi.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
        x:Class="Hoshi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="800"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- Bottom mode bar (DESIGN.md: 36 px). Navigation and mode controls arrive in later phases. -->
    <Border Classes="bottom-bar" DockPanel.Dock="Bottom" x:Name="BottomBar">
      <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding StatusText}" />
    </Border>

    <!-- Board area placeholder: GoBoardControl lands here in Phase 2. -->
    <Panel x:Name="BoardHost" />
  </DockPanel>
</Window>
