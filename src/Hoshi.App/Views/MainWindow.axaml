<Window Icon="/Assets/hoshi.ico"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Hoshi.App.ViewModels"
        xmlns:c="using:Hoshi.App.Controls"
        xmlns:v="using:Hoshi.App.Views"
        xmlns:sys="using:System"
        xmlns:l="using:Hoshi.App.Localization"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
        x:Class="Hoshi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Game.Title}"
        Width="1200" Height="820"
        MinWidth="640" MinHeight="480"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!-- Shortcuts that are safe while typing in the comment box (modifier keys, or keys a TextBox consumes). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Left" Command="{Binding StepBackCommand}" />
    <KeyBinding Gesture="Right" Command="{Binding Game.GoForwardCommand}" />
    <KeyBinding Gesture="Home" Command="{Binding Game.GoFirstCommand}" />
    <KeyBinding Gesture="End" Command="{Binding Game.GoLastCommand}" />
    <KeyBinding Gesture="Up" Command="{Binding Game.PreviousVariationCommand}" />
    <KeyBinding Gesture="Down" Command="{Binding Game.NextVariationCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding Game.UndoCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding Game.OpenCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding OpenReplaysCommand}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding OpenJosekiCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenTsumegoCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding Game.SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding Game.SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding Share.CopySgfCommand}" />
    <KeyBinding Gesture="Ctrl+Space" Command="{Binding TogglePauseGameCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding Share.PasteSgfCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding Game.ToggleEditModeCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding Game.EditGameInfoCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding OpenLobbyCommand}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding PlayEngineCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenPreferencesCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Game.NewGameCommand}">
      <KeyBinding.CommandParameter>
        <sys:Int32>19</sys:Int32>
      </KeyBinding.CommandParameter>
    </KeyBinding>
  </Window.KeyBindings>

  <!-- Interface size (Preferences → Appearance): everything scales together. -->
  <LayoutTransformControl LayoutTransform="{Binding UiScaleTransform}" x:Name="UiScaleRoot">
  <Grid ColumnDefinitions="*,Auto,280">
    <DockPanel Grid.Column="0">
      <!-- Bottom bar under the board only (Sabaki): navigation · players · actions. In edit mode it shows the tools. -->
      <Border Classes="bottom-bar" Classes.edit="{Binding Game.IsEditMode}" DockPanel.Dock="Bottom" x:Name="BottomBar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!Joseki.IsActive" />
            <Binding Path="!IsZen" />
          </MultiBinding>
        </Border.IsVisible>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="bar icon" Command="{Binding Game.GoFirstCommand}" ToolTip.Tip="{l:T Main.First}"><c:HoshiIcon Icon="{DynamicResource Icon.First}" Size="18" /></Button>
            <Button Classes="bar icon" Command="{Binding Game.GoBackCommand}" ToolTip.Tip="{l:T Main.Previous}"><c:HoshiIcon Icon="{DynamicResource Icon.Previous}" Size="18" /></Button>
            <Button Classes="bar icon" Command="{Binding Game.GoForwardCommand}" ToolTip.Tip="{l:T Main.Next}"><c:HoshiIcon Icon="{DynamicResource Icon.Next}" Size="18" /></Button>
            <Button Classes="bar icon" Command="{Binding Game.GoLastCommand}" ToolTip.Tip="{l:T Main.Last}"><c:HoshiIcon Icon="{DynamicResource Icon.Last}" Size="18" /></Button>
          </StackPanel>

          <!-- Players, as in Sabaki's bar: black name · turn toggle · white name. -->
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center" Margin="12,0" ClipToBounds="True"
                IsVisible="{Binding !Game.IsEditMode}" x:Name="PlayerInfo">
            <DockPanel HorizontalAlignment="Right">
              <Border DockPanel.Dock="Left" Classes="clock" Classes.low="{Binding Clock.IsBlackLow}" IsVisible="{Binding Clock.HasClock}" Margin="0,0,8,0" x:Name="BlackClock">
                <TextBlock Text="{Binding Clock.BlackText}" />
              </Border>
              <TextBlock DockPanel.Dock="Left" Classes="secondary" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding Game.Board.WhiteCaptures, StringFormat='+{0}'}"
                         IsVisible="{Binding Game.Board.WhiteCaptures}" ToolTip.Tip="{l:T Main.BlackCaptures}" />
              <TextBlock Classes="player" Text="{Binding Game.BlackName}" TextTrimming="CharacterEllipsis" MaxWidth="160"
                         FontWeight="{Binding Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
            </DockPanel>
            <Border Grid.Column="1" Classes="turn-toggle" Margin="10,0" ToolTip.Tip="{l:T Main.Turn}">
              <Panel>
                <Ellipse Classes="turn-knob black" IsVisible="{Binding Game.IsBlackToMove}" HorizontalAlignment="Left" />
                <Ellipse Classes="turn-knob white" IsVisible="{Binding !Game.IsBlackToMove}" HorizontalAlignment="Right" />
              </Panel>
            </Border>
            <DockPanel Grid.Column="2" HorizontalAlignment="Left">
              <Border DockPanel.Dock="Right" Classes="clock" Classes.low="{Binding Clock.IsWhiteLow}" IsVisible="{Binding Clock.HasClock}" Margin="8,0,0,0" x:Name="WhiteClock">
                <TextBlock Text="{Binding Clock.WhiteText}" />
              </Border>
              <TextBlock DockPanel.Dock="Right" Classes="secondary" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding Game.Board.BlackCaptures, StringFormat='+{0}'}"
                         IsVisible="{Binding Game.Board.BlackCaptures}" ToolTip.Tip="{l:T Main.WhiteCaptures}" />
              <TextBlock Classes="player" Text="{Binding Game.WhiteName}" TextTrimming="CharacterEllipsis" MaxWidth="160"
                         FontWeight="{Binding !Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
            </DockPanel>
          </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsVisible="{Binding Game.IsEditMode}" x:Name="EditBar" Classes="appear">
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="{l:T Main.BlackStone}"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.BlackStone}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.BlackStone}"><Ellipse Width="14" Height="14" Fill="#141414" Stroke="#000" StrokeThickness="1" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="{l:T Main.WhiteStone}"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.WhiteStone}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.WhiteStone}"><Ellipse Width="14" Height="14" Fill="#F4F4F4" Stroke="#9A9A9A" StrokeThickness="1" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="{l:T Main.Triangle}"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Triangle}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Triangle}"><c:HoshiIcon Icon="{DynamicResource Icon.Triangle}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="{l:T Main.Square}"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Square}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Square}"><c:HoshiIcon Icon="{DynamicResource Icon.Square}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="{l:T Main.Circle}"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Circle}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Circle}"><c:HoshiIcon Icon="{DynamicResource Icon.Circle}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="{l:T Main.Cross}"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Cross}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Cross}"><c:HoshiIcon Icon="{DynamicResource Icon.Cross}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="{l:T Main.Label}"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Label}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Label}"><c:HoshiIcon Icon="{DynamicResource Icon.Label}" Size="17" /></RadioButton>
        </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="bar" Command="{Binding Game.PassCommand}" ToolTip.Tip="{l:T Main.PassTip}" x:Name="PassButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Pass}" Size="17" /><TextBlock Classes="label" Text="{l:T Main.Pass}" VerticalAlignment="Center" x:Name="PassLabel" /></StackPanel></Button>
            <Button Classes="bar" Command="{Binding Game.UndoCommand}" ToolTip.Tip="{l:T Main.UndoTip}" x:Name="UndoButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Undo}" Size="17" /><TextBlock Classes="label" Text="{l:T Main.Undo}" VerticalAlignment="Center" /></StackPanel></Button>
            <!-- Narrow windows: these go into the "more" menu (code-behind sets the size classes). -->
            <StackPanel Orientation="Horizontal" Spacing="2" x:Name="OptionalBarButtons">
            <Button Classes="bar toggle" Classes.on="{Binding Analysis.IsTerritoryOn}" Command="{Binding Analysis.ToggleTerritoryCommand}"
                    ToolTip.Tip="{l:T Main.TerritoryTip}" x:Name="TerritoryButton"
                    >
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!Game.IsEditMode" />
                  
                </MultiBinding>
              </Button.IsVisible><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Territory}" Size="17" /><TextBlock Classes="label" Text="{l:T Main.Territory}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="bar toggle" Classes.on="{Binding JosekiHints.IsOn}" Command="{Binding JosekiHints.ToggleCommand}"
                    ToolTip.Tip="{l:T Main.JosekiTip}" x:Name="JosekiButton">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!Game.IsEditMode" />
                  <Binding Path="!JosekiHints.IsBlocked" />
                </MultiBinding>
              </Button.IsVisible><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Star}" Size="17" /><TextBlock Classes="label" Text="{l:T Main.JosekiHints}" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <Button Classes="bar toggle" Classes.on="{Binding Analysis.IsAnalysisOn}" Command="{Binding Analysis.ToggleAnalysisCommand}"
                    ToolTip.Tip="{l:T Main.AnalysisTip}" x:Name="AnalysisButton"
                    >
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!Game.IsEditMode" />
                  <Binding Path="!Analysis.IsBlocked" />
                </MultiBinding>
              </Button.IsVisible><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Analysis}" Size="17" /><TextBlock Classes="label" Text="{l:T Main.Analysis}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="bar toggle" Classes.on="{Binding Study.IsActive}" Command="{Binding Study.ToggleCommand}"
                    ToolTip.Tip="{l:T Main.StudyTip}" x:Name="StudyButton" IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Study}" Size="17" /><TextBlock Classes="label" Text="{l:T Main.Study}" VerticalAlignment="Center" /></StackPanel></Button>
<Panel x:Name="OnlineButtonHost">
            <Button Classes="bar" Command="{Binding OpenLobbyCommand}" ToolTip.Tip="{l:T Main.OnlineTip}" x:Name="OnlineButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Online}" Size="17" /><TextBlock Classes="label" Text="{l:T Main.Online}" VerticalAlignment="Center" /></StackPanel></Button>
            </Panel>
            <Button Classes="bar icon" ToolTip.Tip="{l:T Main.MoreTip}" x:Name="MoreButton" IsVisible="False">
              <TextBlock Text="⋯" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{l:T Main.Territory}" Command="{Binding Analysis.ToggleTerritoryCommand}" ToggleType="CheckBox" IsChecked="{Binding Analysis.IsTerritoryOn, Mode=OneWay}" />
                  <MenuItem Header="{l:T Main.JosekiHints}" Command="{Binding JosekiHints.ToggleCommand}" ToggleType="CheckBox" IsChecked="{Binding JosekiHints.IsOn, Mode=OneWay}" IsVisible="{Binding !JosekiHints.IsBlocked}" />
                  <MenuItem Header="{l:T Main.Online}" Command="{Binding OpenLobbyCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="bar" Command="{Binding Game.ToggleEditModeCommand}" IsVisible="{Binding Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Check}" Size="17" /><TextBlock Text="{l:T Main.FinishEditing}" VerticalAlignment="Center" /></StackPanel></Button>
            <!-- Board effects: explosions, shattering captures, atari alert — Off / Subtle / Full, also with F. -->
            <Button Classes="bar icon" ToolTip.Tip="{Binding Effects.Tooltip}" x:Name="EffectsButton" Classes.dim="{Binding Effects.IsOff}">
              <c:HoshiIcon Icon="{DynamicResource Icon.Effects}" Size="18" />
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight">
                  <StackPanel Width="250" Spacing="8" Margin="4" x:Name="EffectsPanel">
                    <TextBlock Text="{l:T Effects.Title}" FontWeight="SemiBold" />
                    <StackPanel Spacing="2" x:Name="EffectsLevels">
                        <RadioButton GroupName="effects-bar" Content="{l:T Effects.Off}" IsChecked="{Binding Effects.IsOff}" />
                        <RadioButton GroupName="effects-bar" Content="{l:T Effects.Subtle}" IsChecked="{Binding Effects.IsSubtle}" />
                        <RadioButton GroupName="effects-bar" Content="{l:T Effects.Full}" IsChecked="{Binding Effects.IsFull}" />
                      </StackPanel>
                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{l:T Effects.Hint}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- Sound: the panel mutes everything and sets the effects and music volumes. -->
            <Button Classes="bar icon" ToolTip.Tip="{Binding Audio.Tooltip, FallbackValue={x:Null}}" x:Name="AudioButton"
                    IsVisible="{Binding Audio, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Panel>
                <c:HoshiIcon Icon="{DynamicResource Icon.Volume}" Size="18" IsVisible="{Binding !Audio.IsMuted, FallbackValue=True}" />
                <c:HoshiIcon Icon="{DynamicResource Icon.Muted}" Size="18" IsVisible="{Binding Audio.IsMuted, FallbackValue=False}" />
              </Panel>
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight" Opened="OnAudioOpened">
                  <StackPanel Width="250" Spacing="6" Margin="4" x:Name="AudioPanel">
                    <Button Classes.accent="{Binding !Audio.IsMuted}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{Binding Audio.MuteLabel}" Command="{Binding Audio.ToggleMuteCommand}" x:Name="MuteButton" />
                    <StackPanel Spacing="6" IsEnabled="{Binding !Audio.IsMuted}">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <TextBlock Text="{l:T Audio.Effects}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Audio.SoundVolume, StringFormat={}{0} %}" VerticalAlignment="Center" />
                      </Grid>
                      <Slider Minimum="0" Maximum="100" Value="{Binding Audio.SoundVolume}" x:Name="EffectsVolume" />
                      <CheckBox Content="{l:T Audio.StoneSounds}" IsChecked="{Binding Audio.StoneSounds}" />
                      <Separator Margin="0,4" />
                      <ToggleSwitch OnContent="{l:T Audio.Music}" OffContent="{l:T Audio.Music}" IsChecked="{Binding Audio.Music}" x:Name="MusicSwitch" />
                      <Slider Minimum="0" Maximum="100" Value="{Binding Audio.MusicVolume}" IsEnabled="{Binding Audio.Music}" x:Name="MusicVolume" />
                      <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding Audio.MusicProblem}"
                                 IsVisible="{Binding Audio.MusicProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Separator Margin="0,4" />
                    <TextBlock Text="{l:T Effects.Title}" />
                    <StackPanel Spacing="2" x:Name="AudioEffectsLevels">
                        <RadioButton GroupName="effects-audio" Content="{l:T Effects.Off}" IsChecked="{Binding Effects.IsOff}" />
                        <RadioButton GroupName="effects-audio" Content="{l:T Effects.Subtle}" IsChecked="{Binding Effects.IsSubtle}" />
                        <RadioButton GroupName="effects-audio" Content="{l:T Effects.Full}" IsChecked="{Binding Effects.IsFull}" />
                      </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="bar icon" ToolTip.Tip="{l:T Main.MenuTip}" x:Name="MenuButton">
              <c:HoshiIcon Icon="{DynamicResource Icon.Menu}" Size="18" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{l:T Main.New19}" Command="{Binding Game.NewGameCommand}" InputGesture="Ctrl+N">
                  <MenuItem.CommandParameter><sys:Int32>19</sys:Int32></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="{l:T Main.New13}" Command="{Binding Game.NewGameCommand}">
                  <MenuItem.CommandParameter><sys:Int32>13</sys:Int32></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="{l:T Main.New9}" Command="{Binding Game.NewGameCommand}">
                  <MenuItem.CommandParameter><sys:Int32>9</sys:Int32></MenuItem.CommandParameter>
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:T Main.Open}" Command="{Binding Game.OpenCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="{l:T Main.Save}" Command="{Binding Game.SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="{l:T Main.SaveAs}" Command="{Binding Game.SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <MenuItem Header="{l:T Share.Menu}" x:Name="ShareMenu">
                  <MenuItem Header="{l:T Share.Image}" Command="{Binding Share.ExportImageCommand}" />
                  <MenuItem Header="{l:T Share.Animation}" Command="{Binding Share.ExportAnimationCommand}" ToolTip.Tip="{l:T Share.AnimationTip}" />
                  <MenuItem Header="{l:T Share.Card}" ToolTip.Tip="{l:T Share.CardTip}">
                    <MenuItem Header="{l:T Share.CardSquare}" Command="{Binding Share.ExportCardCommand}" CommandParameter="Square" />
                    <MenuItem Header="{l:T Share.CardWide}" Command="{Binding Share.ExportCardCommand}" CommandParameter="Wide" />
                    <MenuItem Header="{l:T Share.CardStory}" Command="{Binding Share.ExportCardCommand}" CommandParameter="Story" />
                  </MenuItem>
                  <MenuItem Header="{l:T Share.Problem}" Command="{Binding Share.ExportProblemCommand}" ToolTip.Tip="{l:T Share.ProblemTip}" />
                  <MenuItem Header="{l:T Share.Summary}" ToolTip.Tip="{l:T Share.SummaryTip}" IsVisible="{Binding Share.HasSummary}">
                    <MenuItem Header="{l:T Share.SummaryMonth}" Command="{Binding Share.ExportSummaryCommand}" CommandParameter="Month" />
                    <MenuItem Header="{l:T Share.SummaryYear}" Command="{Binding Share.ExportSummaryCommand}" CommandParameter="Year" />
                  </MenuItem>
                  <MenuItem Header="{l:T Share.WebViewer}" Command="{Binding Share.ExportWebViewerCommand}" ToolTip.Tip="{l:T Share.WebViewerTip}" />
                  <Separator />
                  <MenuItem Header="{l:T Share.CopyDiagram}" Command="{Binding Share.CopyDiagramCommand}" />
                  <MenuItem Header="{l:T Share.CopyCodeBlock}" Command="{Binding Share.CopyCodeBlockCommand}" />
                  <MenuItem Header="{l:T Share.CopySgf}" Command="{Binding Share.CopySgfCommand}" InputGesture="Ctrl+Shift+C" />
                  <MenuItem Header="{l:T Share.PasteSgf}" Command="{Binding Share.PasteSgfCommand}" InputGesture="Ctrl+Shift+V" />
                  <Separator />
                  <MenuItem Header="{l:T Share.HideNames}" ToggleType="CheckBox" IsChecked="{Binding Share.HideNames}" />
                  <MenuItem Header="{l:T Share.ShowBrand}" ToggleType="CheckBox" IsChecked="{Binding Share.ShowBrand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:T Main.GameInfo}" Command="{Binding Game.EditGameInfoCommand}" InputGesture="Ctrl+I" />
                <MenuItem Header="{l:T Main.PromoteVariation}" Command="{Binding Game.PromoteVariationCommand}" ToolTip.Tip="{l:T Main.PromoteVariationTip}" />
                <MenuItem Header="{l:T Main.DeleteNode}" Command="{Binding Game.DeleteNodeCommand}" ToolTip.Tip="{l:T Main.DeleteNodeTip}" />
                <Separator />
                <MenuItem Header="{l:T Main.EditMode}" Command="{Binding Game.ToggleEditModeCommand}" InputGesture="Ctrl+E" />
                <MenuItem Header="{l:T Main.PlayOnline}" Command="{Binding OpenLobbyCommand}" InputGesture="Ctrl+L" />
                <MenuItem Header="{l:T Main.PlayEngine}" Command="{Binding PlayEngineCommand}" InputGesture="Ctrl+G" x:Name="PlayEngineItem" />
                <MenuItem Header="{l:T Main.GtpConsole}" Command="{Binding OpenGtpConsoleCommand}" x:Name="GtpConsoleItem" />
                <MenuItem Header="{l:T Main.Replays}" Command="{Binding OpenReplaysCommand}" InputGesture="Ctrl+R" />
                <MenuItem Header="{l:T Main.Joseki}" Command="{Binding OpenJosekiCommand}" InputGesture="Ctrl+J" />
                <MenuItem Header="{l:T Tsumego.Menu}" Command="{Binding OpenTsumegoCommand}" InputGesture="Ctrl+P" x:Name="TsumegoItem" />
                <MenuItem Header="{l:T Main.StudyMenu}" Command="{Binding Study.ToggleCommand}" InputGesture="S" />
                <MenuItem Header="{l:T Study.Quiz}" Command="{Binding Study.StartQuizCommand}" ToolTip.Tip="{l:T Study.QuizTip}" />
                <MenuItem Header="{l:T Count.Menu}" Command="{Binding Counting.StartCommand}" x:Name="CountItem" ToolTip.Tip="{l:T Count.MenuTip}" />
                <MenuItem Header="{l:T Review.Menu}" Command="{Binding AnnotateReviewCommand}" x:Name="ReviewItem" />
                <MenuItem Header="{l:T Clock.Menu}" x:Name="ClockMenu" IsVisible="{Binding IsLocal}" ToolTip.Tip="{l:T Clock.LocalOnly}">
                  <MenuItem Header="{Binding Clock.Presets[0].Name}" Command="{Binding Clock.StartCommand}" CommandParameter="{Binding Clock.Presets[0]}" />
                  <MenuItem Header="{Binding Clock.Presets[1].Name}" Command="{Binding Clock.StartCommand}" CommandParameter="{Binding Clock.Presets[1]}" />
                  <MenuItem Header="{Binding Clock.Presets[2].Name}" Command="{Binding Clock.StartCommand}" CommandParameter="{Binding Clock.Presets[2]}" />
                  <MenuItem Header="{Binding Clock.Presets[3].Name}" Command="{Binding Clock.StartCommand}" CommandParameter="{Binding Clock.Presets[3]}" />
                  <MenuItem Header="{Binding Clock.Presets[4].Name}" Command="{Binding Clock.StartCommand}" CommandParameter="{Binding Clock.Presets[4]}" />
                  <MenuItem Header="{Binding Clock.Presets[5].Name}" Command="{Binding Clock.StartCommand}" CommandParameter="{Binding Clock.Presets[5]}" />
                  <Separator />
                  <MenuItem Header="{Binding PauseGameLabel}" Command="{Binding TogglePauseGameCommand}" />
                  <MenuItem Header="{l:T Clock.Remove}" Command="{Binding Clock.RemoveCommand}" IsEnabled="{Binding Clock.HasClock}" />
                </MenuItem>
                <MenuItem Header="{Binding PauseGameLabel}" Command="{Binding TogglePauseGameCommand}" IsVisible="{Binding CanPauseGame}" ToolTip.Tip="{l:T Pause.Tip}" InputGesture="Ctrl+Space" x:Name="PauseItem" />
                <MenuItem Header="{l:T Zen.Menu}" Command="{Binding ToggleZenCommand}" InputGesture="Z" x:Name="ZenItem" />
                <Separator />
                <MenuItem Header="{l:T Welcome.Menu}" Command="{Binding Welcome.OpenCommand}" x:Name="WelcomeItem" />
                <MenuItem Header="{l:T Main.Preferences}" Command="{Binding OpenPreferencesCommand}" InputGesture="Ctrl+OemComma" />
                <MenuItem Header="{l:T Main.CheckUpdates}" Command="{Binding Updates.CheckNowCommand, FallbackValue={x:Null}}" x:Name="CheckUpdatesItem" />
                <MenuItem Header="{l:T Support.Menu}" Command="{Binding Updates.SupportCommand, FallbackValue={x:Null}}" x:Name="SupportItem" />
              </MenuFlyout>
            </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Board area; single-letter shortcuts live here so they do not fire while typing a comment. -->
      <Panel x:Name="BoardArea" Background="{DynamicResource Bg.Surround}">
        <c:ThemeBackground x:Name="Backdrop" Kind="{DynamicResource Theme.Background}" Animate="{DynamicResource Theme.Animations}" Paused="{Binding IsBackgroundStill}" />
        <Panel.KeyBindings>
          <KeyBinding Gesture="P" Command="{Binding Game.PassKeyCommand}" />
          <KeyBinding Gesture="T" Command="{Binding Analysis.ToggleTerritoryCommand}" />
          <KeyBinding Gesture="A" Command="{Binding Analysis.ToggleAnalysisCommand}" />
          <KeyBinding Gesture="M" Command="{Binding ToggleMusicCommand}" />
          <KeyBinding Gesture="F" Command="{Binding Effects.CycleCommand}" />
          <KeyBinding Gesture="J" Command="{Binding JosekiHints.ToggleCommand}" />
          <KeyBinding Gesture="S" Command="{Binding Study.ToggleCommand}" />
          <KeyBinding Gesture="Z" Command="{Binding ToggleZenCommand}" />
          <KeyBinding Gesture="N" Command="{Binding Joseki.NextCommand}" />
          <KeyBinding Gesture="H" Command="{Binding Joseki.ShowAnswerCommand}" />
          <KeyBinding Gesture="R" Command="{Binding Joseki.RestartCommand}" />
          <KeyBinding Gesture="Escape" Command="{Binding Joseki.CloseCommand}" />
          <KeyBinding Gesture="Back" Command="{Binding Joseki.BackCommand}" />
        </Panel.KeyBindings>
        <c:GoBoardControl x:Name="Board" AutomationProperties.Name="{Binding Game.BoardDescription}" AutomationProperties.LiveSetting="Polite"
                          Margin="24"
                          IsVisible="{Binding !Joseki.IsActive}"
                          JosekiHints="{Binding JosekiHints.Hints}"
                          Board="{Binding Game.Board}"
                          BoardStyle="{DynamicResource Theme.Board}"
                          Territory="{Binding BoardTerritory}"
                          Suggestions="{Binding Analysis.BoardSuggestions}"
                          Impact="{Binding Analysis.Impact}"
                          Effects="{Binding BoardEffects}"
                          GroupStatuses="{Binding Analysis.GroupStatuses}"
                          Animate="{DynamicResource Theme.Animations}"
                          LastMove="{Binding Game.LastMove}"
                          ShowCoordinates="{Binding ShowCoordinates}"
                          MoveNumbers="{Binding Game.MoveNumberLabels}"
                          Markers="{Binding Game.Markers}"
                          HoverPoint="{Binding Game.HoverPoint}"
                          GhostStone="{Binding Study.GhostStone}"
                          PendingPoint="{Binding Game.PendingMove}"
                          PendingStone="{Binding Game.PendingStone}"
                          StudyDrawings="{Binding Study.BoardDrawings}"
                          PendingDrawingIds="{Binding Study.PendingDrawingIds}"
                          DragPreview="{Binding Study.DragPreview}"
                          DragColor="{Binding Study.Color}"
                          PointClickedCommand="{Binding Study.BoardClickCommand}"
                          PointDraggedCommand="{Binding Study.BoardDragCommand}"
                          ScrollCommand="{Binding Game.ScrollCommand}" />
        <!-- Counting at the end of a local game: the result, and accept or keep playing. -->
        <Border x:Name="CountingCard" IsVisible="{Binding Counting.IsActive}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                MaxWidth="460" Padding="14,10" CornerRadius="12" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Counting.ResultText}" FontWeight="SemiBold" FontSize="15" x:Name="CountingCardResult" />
            <TextBlock Classes="secondary" Text="{Binding Counting.DetailText}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Classes="secondary" Text="{l:T Count.Hint}" TextWrapping="Wrap" FontSize="11.5" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{l:T Count.KeepPlaying}" Command="{Binding Counting.KeepPlayingCommand}" MinHeight="36" VerticalContentAlignment="Center" />
              <Button Classes="accent" Content="{l:T Count.Accept}" Command="{Binding Counting.AcceptCommand}" MinHeight="36" VerticalContentAlignment="Center" x:Name="CountingCardAccept" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- The first-start tour (and the menu's "Welcome tour"). -->
        <Border x:Name="WelcomeCard" IsVisible="{Binding Welcome.IsOpen}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                MaxWidth="440" Padding="22,18" CornerRadius="16" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1" BoxShadow="0 12 40 0 #80000000">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Welcome.Title}" FontFamily="{DynamicResource Font.Title}" FontSize="21" TextWrapping="Wrap" x:Name="WelcomeCardTitle" />
              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Welcome.StepText}" VerticalAlignment="Top" Margin="10,4,0,0" />
            </Grid>
            <TextBlock Text="{Binding Welcome.Text}" TextWrapping="Wrap" LineHeight="21" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <Button Content="{l:T Welcome.Skip}" Command="{Binding Welcome.CloseCommand}" IsVisible="{Binding !Welcome.IsLast}" Classes="bar" />
              <Button Grid.Column="1" Content="{l:T Welcome.Rules}" Command="{Binding Welcome.LearnRulesCommand}" IsVisible="{Binding Welcome.IsLast}" HorizontalAlignment="Left" x:Name="WelcomeCardRules" />
              <Button Grid.Column="2" Content="{l:T Welcome.Back}" Command="{Binding Welcome.BackCommand}" IsVisible="{Binding !Welcome.IsFirst}" MinHeight="36" />
              <Button Grid.Column="3" Classes="accent" Command="{Binding Welcome.NextCommand}" MinHeight="36" x:Name="WelcomeCardNext">
                <Panel>
                  <TextBlock Text="{l:T Welcome.Next}" IsVisible="{Binding !Welcome.IsLast}" />
                  <TextBlock Text="{l:T Welcome.Done}" IsVisible="{Binding Welcome.IsLast}" />
                </Panel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
        <!-- Your move in another OGS game: open it or dismiss. -->
        <Border x:Name="TurnCard" IsVisible="{Binding TurnNotice, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="warmup"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Padding="12,6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TurnNotice.Text, FallbackValue={x:Null}}" VerticalAlignment="Center" />
            <Button Classes="accent" Content="{l:T Turn.Open}" Command="{Binding OpenTurnGameCommand}" MinHeight="32" VerticalContentAlignment="Center" x:Name="TurnCardOpen" />
            <Button Classes="bar icon" Command="{Binding DismissTurnNoticeCommand}" VerticalAlignment="Center">
              <c:HoshiIcon Icon="{DynamicResource Icon.Close}" Size="12" />
            </Button>
          </StackPanel>
        </Border>
        <!-- Zen mode keeps the players and the clock, small, top left. -->
        <Border x:Name="ZenPlayers" IsVisible="{Binding IsZen}" Classes="warmup" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" Opacity="0.75">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Game.BlackName}" FontSize="12" FontWeight="{Binding Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
            <TextBlock Text="{Binding Clock.BlackText}" FontSize="12" IsVisible="{Binding Clock.HasClock}" />
            <TextBlock Text="·" FontSize="12" Classes="secondary" />
            <TextBlock Text="{Binding Game.WhiteName}" FontSize="12" FontWeight="{Binding !Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
            <TextBlock Text="{Binding Clock.WhiteText}" FontSize="12" IsVisible="{Binding Clock.HasClock}" />
          </StackPanel>
        </Border>
        <!-- Zen mode: only a quiet way out, top right (or Z). -->
        <Button x:Name="ZenExit" IsVisible="{Binding IsZen}" Command="{Binding ToggleZenCommand}" Classes="zen-exit"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0" ToolTip.Tip="{l:T Zen.ExitHint}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:HoshiIcon Icon="{DynamicResource Icon.Close}" Size="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{l:T Zen.Exit}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource Bg.PanelAlt}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="Z" FontSize="11" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Secondary}" />
            </Border>
          </StackPanel>
        </Button>
        <Button x:Name="JosekiExitPill" IsVisible="{Binding Joseki.IsActive}" Command="{Binding Joseki.CloseCommand}" Classes="zen-exit"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0" ToolTip.Tip="{l:T Joseki.BackToGame}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:HoshiIcon Icon="{DynamicResource Icon.Back}" Size="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{l:T Joseki.BackToGameShort}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- Paused local game: the board waits under a card (clicks do not reach it). -->
        <Border x:Name="PausedOverlay" IsVisible="{Binding IsGamePaused}" Background="#99000000">
          <Border Classes="warmup" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,16">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <TextBlock Text="{l:T Pause.Title}" FontSize="22" FontFamily="{DynamicResource Font.Title}" HorizontalAlignment="Center" />
              <Button Classes="accent" Content="{l:T Pause.Resume}" Command="{Binding TogglePauseGameCommand}" HorizontalAlignment="Center" x:Name="ResumeButton" />
            </StackPanel>
          </Border>
        </Border>
        <!-- The joseki trainer uses the same place on screen; the game stays as it was underneath. -->
        <c:GoBoardControl x:Name="JosekiBoard"
                          Margin="24"
                          IsVisible="{Binding Joseki.IsActive}"
                          Board="{Binding Joseki.Board}"
                          BoardStyle="{DynamicResource Theme.Board}"
                          Animate="{DynamicResource Theme.Animations}"
                          LastMove="{Binding Joseki.LastMove}"
                          Markers="{Binding Joseki.Markers}"
                          HoverPoint="{Binding Joseki.HoverPoint}"
                          GhostStone="{Binding Joseki.GhostStone}"
                          PointClickedCommand="{Binding Joseki.PlayCommand}" />
        <!-- Joseki hints: what the corner of the last move is, per the OGS Joseki Explorer or your library. -->
        <Border Classes="warmup" x:Name="JosekiPill" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                ToolTip.Tip="{Binding JosekiHints.Description}">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="JosekiHints.HasText" />
              <Binding Path="!Joseki.IsActive" />
              <Binding Path="!Study.IsQuizActive" />
            </MultiBinding>
          </Border.IsVisible>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressBar IsIndeterminate="True" Width="28" MinWidth="28" Height="3" MinHeight="3" VerticalAlignment="Center" IsVisible="{Binding JosekiHints.IsSearching}" />
            <TextBlock Text="{Binding JosekiHints.Text}" VerticalAlignment="Center" FontSize="12.5" MaxWidth="560" TextTrimming="CharacterEllipsis" x:Name="JosekiText" />
          </StackPanel>
        </Border>
        <!-- "What would you play?": the question on top of the board while the quiz runs. -->
        <Border Classes="warmup" x:Name="QuizPill" IsHitTestVisible="False" IsVisible="{Binding Study.IsQuizActive}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:HoshiIcon Icon="{DynamicResource Icon.Quiz}" Size="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Study.QuizPrompt}" VerticalAlignment="Center" FontSize="12.5" IsVisible="{Binding Study.CanReveal}" />
            <TextBlock Text="{Binding Study.QuizResult}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" MaxWidth="520" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !Study.CanReveal}" />
          </StackPanel>
        </Border>
        <!-- No KataGo yet: install it with one click (the AI analysis, effects and music need it). -->
        <Border x:Name="KataGoCard" IsVisible="{Binding KataGoSetup.IsPromptVisible, FallbackValue=False}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,20" MaxWidth="360"
                Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="14,12">
          <StackPanel Spacing="8">
            <TextBlock Text="{l:T KataGo.Title}" FontWeight="SemiBold" />
            <TextBlock Classes="secondary" Text="{Binding KataGoSetup.Explanation}" TextWrapping="Wrap" FontSize="12.5" />
            <TextBlock Classes="secondary" Text="{Binding KataGoSetup.StatusText}" TextWrapping="Wrap" FontSize="12.5" x:Name="KataGoStatus"
                       IsVisible="{Binding KataGoSetup.HasStatus, FallbackValue=False}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding KataGoSetup.Progress}" Height="4" MinHeight="4" IsVisible="{Binding KataGoSetup.IsInstalling, FallbackValue=False}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{l:T KataGo.NotNow}" Command="{Binding KataGoSetup.NotNowCommand}" />
              <Button Classes="accent" Content="{Binding KataGoSetup.InstallLabel}" Command="{Binding KataGoSetup.InstallCommand}" x:Name="KataGoInstall"
                      IsVisible="{Binding KataGoSetup.CanInstallHere, FallbackValue=False}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- A newer Hoshi is out: update in place (or open the download page), later, or skip this version. -->
        <Border x:Name="UpdateBanner" Classes="update-banner" IsVisible="{Binding Updates.IsVisible, FallbackValue=False}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" MaxWidth="360"
                Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14,12">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Updates.Text}" FontWeight="SemiBold" TextWrapping="Wrap" x:Name="UpdateText"
                       IsVisible="{Binding Updates.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="secondary" Text="{Binding Updates.InstallerHint}" TextWrapping="Wrap" FontSize="12.5" x:Name="UpdateHint"
                       IsVisible="{Binding Updates.InstallerHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="secondary" Text="{Binding Updates.StatusText}" TextWrapping="Wrap" FontSize="12.5" x:Name="UpdateStatus"
                       IsVisible="{Binding Updates.HasStatus, FallbackValue=False}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Updates.Progress}" Height="4" MinHeight="4" IsVisible="{Binding Updates.IsBusy, FallbackValue=False}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{l:T Update.Skip}" Command="{Binding Updates.SkipCommand}" IsVisible="{Binding Updates.Available, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button Content="{l:T Update.Later}" Command="{Binding Updates.LaterCommand}" x:Name="UpdateLater" />
              <Button Classes="accent" Content="{Binding Updates.UpdateLabel}" Command="{Binding Updates.UpdateCommand}" x:Name="UpdateNow"
                      IsVisible="{Binding Updates.Available, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- After an update: a quiet thank-you with the (optional) support link, once per version. -->
        <Border x:Name="ThanksBanner" IsVisible="{Binding Updates.ShowThanks, FallbackValue=False}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" MaxWidth="360"
                Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="14,12">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Updates.ThanksText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="secondary" Text="{l:T Support.Ask}" TextWrapping="Wrap" FontSize="12.5" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{l:T Support.Close}" Command="{Binding Updates.DismissThanksCommand}" x:Name="ThanksClose" />
              <Button Classes="accent" Content="{l:T Support.Button}" Command="{Binding Updates.SupportCommand}" x:Name="ThanksSupport" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- KataGo warming up in the background (first launch can take minutes while it tunes the GPU). -->
        <Border Classes="warmup" x:Name="WarmupPill" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                Opacity="{Binding Analysis.IsWarmingUp, Converter={x:Static c:BoolToOpacityConverter.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="True" Width="56" MinWidth="56" Height="3" MinHeight="3" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Analysis.WarmupText}" VerticalAlignment="Center" FontSize="12.5" MaxWidth="520" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Panel>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource Border.Subtle}" ResizeDirection="Columns" x:Name="SidebarSplitter" />

    <!-- Sidebar: players, variation tree, comment. Width 220–420 (DESIGN.md). -->
      <Grid Grid.Column="2" x:Name="Sidebar" MinWidth="220" MaxWidth="420"
            Background="{DynamicResource Bg.Sidebar}" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Border Grid.Row="0" Classes="game-header" IsVisible="{Binding IsLocal}" x:Name="GameHeader">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Game.HeaderTitle}" FontFamily="{DynamicResource Font.Title}" FontSize="{DynamicResource Font.Size.Title}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="secondary" Text="{Binding Game.HeaderSubtitle}" TextTrimming="CharacterEllipsis" />
            <!-- A game against an engine (or between two): who plays, what the engine is doing, pause and end. -->
            <Border x:Name="EngineBar" Classes="appear" Margin="0,8,0,0" Padding="10,8" CornerRadius="8"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                    IsVisible="{Binding EngineMatch.IsActive, FallbackValue=False}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding EngineMatch.Title, FallbackValue={x:Null}}" x:Name="EngineTitle">
                  <c:HoshiIcon Grid.RowSpan="2" Icon="{DynamicResource Icon.Engine}" Size="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Accent}" />
                  <Ellipse Grid.Column="1" Width="10" Height="10" Fill="#1A1A1A" Stroke="#9A9A9A" StrokeThickness="1" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding EngineMatch.BlackLabel, FallbackValue={x:Null}}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Ellipse Grid.Row="1" Grid.Column="1" Width="10" Height="10" Fill="#EEE" Stroke="#888" StrokeThickness="1" Margin="0,4,7,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding EngineMatch.WhiteLabel, FallbackValue={x:Null}}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding EngineMatch.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                  <ProgressBar IsIndeterminate="True" Width="24" MinWidth="24" Height="3" MinHeight="3" VerticalAlignment="Center"
                               IsVisible="{Binding EngineMatch.Thinker, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                  <TextBlock Classes="secondary" Text="{Binding EngineMatch.StatusText, FallbackValue={x:Null}}" FontSize="12" TextWrapping="Wrap"
                             x:Name="EngineStatusText" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="{Binding EngineMatch.PauseLabel, FallbackValue={x:Null}}" Command="{Binding EngineMatch.TogglePauseCommand, FallbackValue={x:Null}}" x:Name="EnginePause" />
                  <Button Content="{l:T Engines.End}" Command="{Binding EngineMatch.StopCommand, FallbackValue={x:Null}}" ToolTip.Tip="{l:T Engines.EndTip}" x:Name="EngineStop" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Classes="panel-header" Padding="12,10" IsVisible="{Binding IsOnline}">
          <Panel>


            <!-- Online game: names, clocks, actions (Phase 5). -->
            <StackPanel x:Name="OnlinePanel" Classes="appear" IsVisible="{Binding IsOnline}" Spacing="8">
              <v:OnlinePanelView />
</StackPanel>
          </Panel>
        </Border>

        <!-- Analysis: territory summary, engine evaluation of the last move, score graph. -->
        <Border Grid.Row="1" Classes="analysis" x:Name="AnalysisPanel"
                IsVisible="{Binding Analysis.IsAnalysisActive}">
          <v:AnalysisPanelView />
</Border>
        <Border Grid.Row="1" Classes="analysis" IsVisible="{Binding !Analysis.IsAnalysisOn}">
          <StackPanel IsVisible="{Binding Analysis.IsTerritoryOn}" Spacing="4">
            <TextBlock Classes="secondary" Text="{Binding Analysis.TerritoryText}" TextWrapping="Wrap"
                       IsVisible="{Binding Analysis.TerritoryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="secondary" Text="{Binding Analysis.StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}"
                       IsVisible="{Binding Analysis.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" x:Name="TreeScroll">
          <c:GameTreeControl x:Name="GameTree"
                             Verdicts="{Binding Analysis.NodeVerdicts}"
                             Root="{Binding Game.Tree.Root}"
                             Current="{Binding Game.CurrentNode}"
                             Version="{Binding Game.TreeVersion}"
                             BoardSize="{Binding Game.Board.Width}"
                             NodeClickedCommand="{Binding Game.GoToNodeCommand}"
                             HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>

        <GridSplitter Grid.Row="3" Height="3" Background="{DynamicResource Border.Subtle}" ResizeDirection="Rows" />

        <Border Grid.Row="4" Classes="properties-header">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Classes="secondary" Text="{Binding Game.StatusText}" TextTrimming="CharacterEllipsis" x:Name="StatusText"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Game.MoveNumberText}" Margin="8,0,0,0" x:Name="MoveNumber" />
            <!-- Accessibility: play by typing a coordinate (Preferences → Appearance). -->
            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Text="{Binding MoveEntryText}" Watermark="{l:T Access.MoveEntry}"
                     IsVisible="{Binding ShowMoveEntry}" x:Name="MoveEntryBox" AutomationProperties.Name="{l:T Access.MoveEntry}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding PlayEntryCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </Grid>
        </Border>

        <DockPanel Grid.Row="5" Background="{DynamicResource Bg.Properties}" MinHeight="200">
          <DockPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsLocal" />
              <Binding Path="!Study.IsActive" />
            </MultiBinding>
          </DockPanel.IsVisible>
          <!-- Joseki comments and the colour legend, while joseki hints are on. -->
          <Border DockPanel.Dock="Top" x:Name="JosekiInfo" IsVisible="{Binding JosekiHints.IsActive}"
                  Padding="12,8,12,8" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
              <TextBlock Classes="secondary" FontSize="12" FontWeight="SemiBold" Text="{l:T Joseki.Legend.Title}" />
              <TextBlock Text="{Binding JosekiHints.Text}" IsVisible="{Binding JosekiHints.HasText}" TextWrapping="Wrap" FontSize="12.5" x:Name="JosekiInfoTitle" />
              <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" IsVisible="{Binding JosekiHints.HasNote}">
                <TextBlock Text="{Binding JosekiHints.Note}" TextWrapping="Wrap" FontSize="12.5" x:Name="JosekiNote" />
              </ScrollViewer>
              <ItemsControl ItemsSource="{Binding JosekiHints.Legend}" x:Name="JosekiLegend" ToolTip.Tip="{l:T Joseki.Legend.Tip}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JosekiLegendItem">
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,3">
                      <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Stroke="#D0FFFFFF" StrokeThickness="1" VerticalAlignment="Center" />
                      <TextBlock Classes="secondary" Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <TextBox x:Name="CommentBox" Classes="comment" IsVisible="{Binding IsLocal}"
                   AcceptsReturn="True" TextWrapping="Wrap" Watermark="{l:T Main.Comment}"
                   Text="{Binding Game.Comment}" />
        </DockPanel>

        <DockPanel Grid.Row="5" x:Name="ChatPanel" Classes="appear" Background="{DynamicResource Bg.Properties}" Height="280">
          <DockPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsOnline" />
              <Binding Path="!Study.IsActive" />
            </MultiBinding>
          </DockPanel.IsVisible>
          <v:ChatView />
</DockPanel>
        <!-- Study: tools, the pins timeline, this move's pins and replies, sharing, the quiz and the report (S). -->
        <Border Grid.Row="5" x:Name="StudyPanel" Classes="appear" IsVisible="{Binding Study.IsActive}"
                Background="{DynamicResource Bg.Properties}" Height="500">
          <v:StudyPanelView />
</Border>
        <!-- Joseki trainer panel, over the sidebar while the trainer is on the board. -->
        <Border Grid.RowSpan="6" x:Name="JosekiPanel" IsVisible="{Binding Joseki.IsActive}"
                Background="{DynamicResource Bg.Sidebar}" Padding="16,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8">
              <!-- Leaving the trainer is the first thing in the panel: a clear "back to the game" button. -->
              <Button Classes="bar" Command="{Binding Joseki.CloseCommand}" ToolTip.Tip="{l:T Joseki.BackToGame}" x:Name="JosekiClose"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="-8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:HoshiIcon Icon="{DynamicResource Icon.Back}" Size="16" Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="{l:T Joseki.BackToGameShort}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="Esc" Classes="secondary" FontSize="11" FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="{l:T Joseki.Title}" FontSize="12" Classes="secondary" />
              <TextBlock Text="{Binding Joseki.LineName}" FontSize="20" FontFamily="{DynamicResource Font.Title}" TextWrapping="Wrap" x:Name="JosekiLineName" />
              <TextBlock Classes="secondary" Text="{Binding Joseki.BoxText}" FontSize="12" />
              <TextBlock Text="{Binding Joseki.ProgressText}" x:Name="JosekiProgress" />
              <Border CornerRadius="6" Padding="10,8" Background="{DynamicResource Bg.PanelAlt}">
                <TextBlock Text="{Binding Joseki.StatusText}" TextWrapping="Wrap" x:Name="JosekiStatus"
                           Classes.good="{Binding Joseki.IsStatusGood}" Classes.bad="{Binding Joseki.IsStatusBad}" />
              </Border>
              <TextBlock Classes="secondary" Text="{Binding Joseki.Note}" IsVisible="{Binding Joseki.HasNote}" TextWrapping="Wrap" FontStyle="Italic" MaxHeight="120" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="accent" Content="{l:T Joseki.Next}" Command="{Binding Joseki.NextCommand}" ToolTip.Tip="N" Margin="0,0,6,6" x:Name="JosekiNext" />
                <Button Content="{l:T Joseki.ShowAnswer}" Command="{Binding Joseki.ShowAnswerCommand}" ToolTip.Tip="H" Margin="0,0,6,6" />
                <Button Content="{l:T Joseki.StepBack}" Command="{Binding Joseki.BackCommand}" ToolTip.Tip="{l:T Joseki.StepBackTip}" Margin="0,0,6,6" x:Name="JosekiBack" />
                <Button Content="{l:T Joseki.Restart}" Command="{Binding Joseki.RestartCommand}" ToolTip.Tip="R" Margin="0,0,6,6" />
              </WrapPanel>
              <ComboBox ItemsSource="{Binding Joseki.Families}" SelectedItem="{Binding Joseki.SelectedFamily}" HorizontalAlignment="Stretch" x:Name="JosekiFamily">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:JosekiFamilyOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
              <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding Joseki.LibraryText}" />
              <Button HorizontalAlignment="Stretch" Classes="accent" Command="{Binding Joseki.FetchFromOgsCommand}" IsVisible="{Binding Joseki.HasExplorer}"
                      ToolTip.Tip="{l:T Joseki.FetchTip}" x:Name="JosekiFetch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ProgressBar IsIndeterminate="True" Width="24" MinWidth="24" Height="3" MinHeight="3" VerticalAlignment="Center" IsVisible="{Binding Joseki.IsFetching}" />
                  <TextBlock Text="{l:T Joseki.Fetch}" />
                </StackPanel>
              </Button>
              <Button HorizontalAlignment="Stretch" Content="{l:T Joseki.AddFromBoard}" Command="{Binding Joseki.AddFromBoardCommand}" ToolTip.Tip="{l:T Joseki.AddFromBoardTip}" />
              <Button HorizontalAlignment="Stretch" Content="{l:T Joseki.Import}" Command="{Binding Joseki.ImportCommand}" />
              <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap" Text="{l:T Joseki.Help}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Joseki.Rows}" SelectedItem="{Binding Joseki.SelectedLine}" Background="Transparent" Margin="0,8,0,0" x:Name="JosekiLines">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JosekiLineRow">
                  <StackPanel Margin="0,2" Spacing="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="secondary" Text="{Binding Detail}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
  </Grid>
  </LayoutTransformControl>
</Window>
