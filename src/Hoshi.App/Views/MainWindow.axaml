<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Hoshi.App.ViewModels"
        xmlns:c="using:Hoshi.App.Controls"
        xmlns:sys="using:System"
        xmlns:l="using:Hoshi.App.Localization"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
        x:Class="Hoshi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Game.Title}"
        Width="1200" Height="820"
        MinWidth="640" MinHeight="480"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!-- Shortcuts that are safe while typing in the comment box (modifier keys, or keys a TextBox consumes). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Left" Command="{Binding Game.GoBackCommand}" />
    <KeyBinding Gesture="Right" Command="{Binding Game.GoForwardCommand}" />
    <KeyBinding Gesture="Home" Command="{Binding Game.GoFirstCommand}" />
    <KeyBinding Gesture="End" Command="{Binding Game.GoLastCommand}" />
    <KeyBinding Gesture="Up" Command="{Binding Game.PreviousVariationCommand}" />
    <KeyBinding Gesture="Down" Command="{Binding Game.NextVariationCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding Game.UndoCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding Game.OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding Game.SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding Game.SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding Game.ToggleEditModeCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding Game.EditGameInfoCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding OpenLobbyCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenPreferencesCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Game.NewGameCommand}">
      <KeyBinding.CommandParameter>
        <sys:Int32>19</sys:Int32>
      </KeyBinding.CommandParameter>
    </KeyBinding>
  </Window.KeyBindings>

  <Grid ColumnDefinitions="*,Auto,280">
    <DockPanel Grid.Column="0">
      <!-- Bottom bar under the board only (Sabaki): navigation · players · actions. In edit mode it shows the tools. -->
      <Border Classes="bottom-bar" Classes.edit="{Binding Game.IsEditMode}" DockPanel.Dock="Bottom" x:Name="BottomBar">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="bar icon" Command="{Binding Game.GoFirstCommand}" ToolTip.Tip="Inicio (Home)"><c:HoshiIcon Icon="{DynamicResource Icon.First}" Size="18" /></Button>
            <Button Classes="bar icon" Command="{Binding Game.GoBackCommand}" ToolTip.Tip="Anterior (←)"><c:HoshiIcon Icon="{DynamicResource Icon.Previous}" Size="18" /></Button>
            <Button Classes="bar icon" Command="{Binding Game.GoForwardCommand}" ToolTip.Tip="Siguiente (→)"><c:HoshiIcon Icon="{DynamicResource Icon.Next}" Size="18" /></Button>
            <Button Classes="bar icon" Command="{Binding Game.GoLastCommand}" ToolTip.Tip="Final (End)"><c:HoshiIcon Icon="{DynamicResource Icon.Last}" Size="18" /></Button>
          </StackPanel>

          <!-- Players, as in Sabaki's bar: black name · turn toggle · white name. -->
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center" Margin="12,0"
                IsVisible="{Binding !Game.IsEditMode}" x:Name="PlayerInfo">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
              <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding Game.Board.WhiteCaptures, StringFormat='+{0}'}"
                         IsVisible="{Binding Game.Board.WhiteCaptures}" ToolTip.Tip="Piedras capturadas por negras" />
              <TextBlock Classes="player" Text="{Binding Game.BlackName}" TextTrimming="CharacterEllipsis"
                         FontWeight="{Binding Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="turn-toggle" Margin="10,0" ToolTip.Tip="Turno">
              <Panel>
                <Ellipse Classes="turn-knob black" IsVisible="{Binding Game.IsBlackToMove}" HorizontalAlignment="Left" />
                <Ellipse Classes="turn-knob white" IsVisible="{Binding !Game.IsBlackToMove}" HorizontalAlignment="Right" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="player" Text="{Binding Game.WhiteName}" TextTrimming="CharacterEllipsis"
                         FontWeight="{Binding !Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
              <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding Game.Board.BlackCaptures, StringFormat='+{0}'}"
                         IsVisible="{Binding Game.Board.BlackCaptures}" ToolTip.Tip="Piedras capturadas por blancas" />
            </StackPanel>
          </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsVisible="{Binding Game.IsEditMode}" x:Name="EditBar" Classes="appear">
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="Piedra negra"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.BlackStone}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.BlackStone}"><Ellipse Width="14" Height="14" Fill="#141414" Stroke="#000" StrokeThickness="1" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="Piedra blanca"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.WhiteStone}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.WhiteStone}"><Ellipse Width="14" Height="14" Fill="#F4F4F4" Stroke="#9A9A9A" StrokeThickness="1" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="Triángulo"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Triangle}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Triangle}"><c:HoshiIcon Icon="{DynamicResource Icon.Triangle}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="Cuadrado"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Square}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Square}"><c:HoshiIcon Icon="{DynamicResource Icon.Square}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="Círculo"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Circle}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Circle}"><c:HoshiIcon Icon="{DynamicResource Icon.Circle}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="Cruz"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Cross}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Cross}"><c:HoshiIcon Icon="{DynamicResource Icon.Cross}" Size="17" /></RadioButton>
          <RadioButton Classes="tool" GroupName="tool" ToolTip.Tip="Etiqueta"
                       IsChecked="{Binding Game.EditTool, Converter={x:Static c:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:EditTool.Label}}"
                       Command="{Binding Game.SelectToolCommand}" CommandParameter="{x:Static vm:EditTool.Label}"><c:HoshiIcon Icon="{DynamicResource Icon.Label}" Size="17" /></RadioButton>
        </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="bar" Command="{Binding Game.PassCommand}" ToolTip.Tip="Pasar (P)" x:Name="PassButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Pass}" Size="17" /><TextBlock Text="{l:T Main.Pass}" VerticalAlignment="Center" x:Name="PassLabel" /></StackPanel></Button>
            <Button Classes="bar" Command="{Binding Game.UndoCommand}" ToolTip.Tip="Deshacer (Ctrl+Z)" x:Name="UndoButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Undo}" Size="17" /><TextBlock Text="Deshacer" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="bar toggle" Classes.on="{Binding Analysis.IsTerritoryOn}" Command="{Binding Analysis.ToggleTerritoryCommand}"
                    ToolTip.Tip="Territorio actual y potencial (T)" x:Name="TerritoryButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Territory}" Size="17" /><TextBlock Text="Territorio" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="bar toggle" Classes.on="{Binding Analysis.IsAnalysisOn}" Command="{Binding Analysis.ToggleAnalysisCommand}"
                    ToolTip.Tip="Mostrar el análisis de la IA: panel y sugerencias en el tablero (A). KataGo trabaja siempre de fondo." x:Name="AnalysisButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Analysis}" Size="17" /><TextBlock Text="Análisis" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="bar" Command="{Binding OpenLobbyCommand}" ToolTip.Tip="Jugar en OGS (Ctrl+L)" x:Name="OnlineButton"
                    IsVisible="{Binding !Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Online}" Size="17" /><TextBlock Text="En línea" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="bar" Command="{Binding Game.ToggleEditModeCommand}" IsVisible="{Binding Game.IsEditMode}"><StackPanel Orientation="Horizontal" Spacing="7"><c:HoshiIcon Icon="{DynamicResource Icon.Check}" Size="17" /><TextBlock Text="Terminar edición" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="bar icon" ToolTip.Tip="Menú: archivo, edición, en línea, preferencias" x:Name="MenuButton">
              <c:HoshiIcon Icon="{DynamicResource Icon.Menu}" Size="18" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Nueva 19 × 19" Command="{Binding Game.NewGameCommand}" InputGesture="Ctrl+N">
                  <MenuItem.CommandParameter><sys:Int32>19</sys:Int32></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="Nueva 13 × 13" Command="{Binding Game.NewGameCommand}">
                  <MenuItem.CommandParameter><sys:Int32>13</sys:Int32></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="Nueva 9 × 9" Command="{Binding Game.NewGameCommand}">
                  <MenuItem.CommandParameter><sys:Int32>9</sys:Int32></MenuItem.CommandParameter>
                </MenuItem>
                <Separator />
                <MenuItem Header="Abrir…" Command="{Binding Game.OpenCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="Guardar" Command="{Binding Game.SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Guardar como…" Command="{Binding Game.SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Información de la partida…" Command="{Binding Game.EditGameInfoCommand}" InputGesture="Ctrl+I" />
                <MenuItem Header="Hacer línea principal" Command="{Binding Game.PromoteVariationCommand}" />
                <MenuItem Header="Borrar nodo y variantes" Command="{Binding Game.DeleteNodeCommand}" />
                <Separator />
                <MenuItem Header="Modo edición" Command="{Binding Game.ToggleEditModeCommand}" InputGesture="Ctrl+E" />
                <MenuItem Header="Jugar en línea…" Command="{Binding OpenLobbyCommand}" InputGesture="Ctrl+L" />
                <Separator />
                <MenuItem Header="Preferencias…" Command="{Binding OpenPreferencesCommand}" InputGesture="Ctrl+OemComma" />
              </MenuFlyout>
            </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Board area; single-letter shortcuts live here so they do not fire while typing a comment. -->
      <Panel x:Name="BoardArea" Background="{DynamicResource Bg.Surround}">
        <c:ThemeBackground x:Name="Backdrop" Kind="{DynamicResource Theme.Background}" Animate="{DynamicResource Theme.Animations}" />
        <Panel.KeyBindings>
          <KeyBinding Gesture="P" Command="{Binding Game.PassKeyCommand}" />
          <KeyBinding Gesture="T" Command="{Binding Analysis.ToggleTerritoryCommand}" />
          <KeyBinding Gesture="A" Command="{Binding Analysis.ToggleAnalysisCommand}" />
          <KeyBinding Gesture="M" Command="{Binding ToggleMusicCommand}" />
        </Panel.KeyBindings>
        <c:GoBoardControl x:Name="Board"
                          Margin="24"
                          Board="{Binding Game.Board}"
                          BoardStyle="{DynamicResource Theme.Board}"
                          Territory="{Binding Analysis.Territory}"
                          Suggestions="{Binding Analysis.BoardSuggestions}"
                          Impact="{Binding Analysis.Impact}"
                          AtariGroups="{Binding Analysis.AtariGroups}"
                          Animate="{DynamicResource Theme.Animations}"
                          LastMove="{Binding Game.LastMove}"
                          Markers="{Binding Game.Markers}"
                          HoverPoint="{Binding Game.HoverPoint}"
                          GhostStone="{Binding Game.GhostStone}"
                          PointClickedCommand="{Binding Game.PlayCommand}"
                          ScrollCommand="{Binding Game.ScrollCommand}" />
        <!-- KataGo warming up in the background (first launch can take minutes while it tunes the GPU). -->
        <Border Classes="warmup" x:Name="WarmupPill" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                Opacity="{Binding Analysis.IsWarmingUp, Converter={x:Static c:BoolToOpacityConverter.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="True" Width="56" MinWidth="56" Height="3" MinHeight="3" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Analysis.WarmupText}" VerticalAlignment="Center" FontSize="12.5" MaxWidth="520" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Panel>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource Border.Subtle}" ResizeDirection="Columns" />

    <!-- Sidebar: players, variation tree, comment. Width 220–420 (DESIGN.md). -->
      <Grid Grid.Column="2" x:Name="Sidebar" MinWidth="220" MaxWidth="420"
            Background="{DynamicResource Bg.Sidebar}" RowDefinitions="Auto,Auto,*,Auto,Auto,200">
        <Border Grid.Row="0" Classes="game-header" IsVisible="{Binding IsLocal}" x:Name="GameHeader">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Game.HeaderTitle}" FontFamily="{DynamicResource Font.Title}" FontSize="{DynamicResource Font.Size.Title}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="secondary" Text="{Binding Game.HeaderSubtitle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Classes="panel-header" Padding="12,10" IsVisible="{Binding IsOnline}">
          <Panel>


            <!-- Online game: names, clocks, actions (Phase 5). -->
            <StackPanel x:Name="OnlinePanel" Classes="appear" IsVisible="{Binding IsOnline}" Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <Ellipse Grid.Row="0" Width="10" Height="10" Fill="#1A1A1A" Stroke="#9A9A9A" StrokeThickness="1" Margin="0,0,8,0" />
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Online.BlackName}" TextTrimming="CharacterEllipsis"
                           FontWeight="{Binding Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="clock" Classes.low="{Binding Online.IsBlackClockLow}"
                           Text="{Binding Online.BlackClock}" x:Name="BlackClock" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="secondary" VerticalAlignment="Center" Text="{Binding Game.Board.BlackCaptures, StringFormat='{}{0} cap.'}" />
                <Ellipse Grid.Row="2" Width="10" Height="10" Fill="#EEE" Stroke="#888" StrokeThickness="1" Margin="0,10,8,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Online.WhiteName}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"
                           FontWeight="{Binding !Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="clock" Classes.low="{Binding Online.IsWhiteClockLow}"
                           Text="{Binding Online.WhiteClock}" x:Name="WhiteClock" />
                <TextBlock Grid.Row="3" Grid.Column="2" Classes="secondary" VerticalAlignment="Center" Text="{Binding Game.Board.WhiteCaptures, StringFormat='{}{0} cap.'}" />
              </Grid>
              <TextBlock Text="{Binding Online.StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" x:Name="OnlineStatus" />
              <WrapPanel Orientation="Horizontal">
                <WrapPanel.Styles>
                  <Style Selector="Button"><Setter Property="Margin" Value="0,0,6,6" /></Style>
                </WrapPanel.Styles>
                <Button Content="Pasar" Command="{Binding Online.PassCommand}" IsVisible="{Binding Online.IsPlayPhase}" x:Name="OnlinePassButton" />
                <Button Content="Abandonar" Command="{Binding Online.ResignCommand}" IsVisible="{Binding Online.IsPlayPhase}" x:Name="ResignButton" />
                <Button Content="Pedir deshacer" Command="{Binding Online.RequestUndoCommand}" IsVisible="{Binding Online.IsPlayPhase}" />
                <Button Classes="accent" Content="Aceptar deshacer" Command="{Binding Online.AcceptUndoCommand}" IsVisible="{Binding Online.IsUndoRequested}" />
                <Button Classes="accent" Content="Aceptar conteo" Command="{Binding Online.AcceptScoreCommand}" IsVisible="{Binding Online.IsStoneRemoval}" x:Name="AcceptScoreButton" />
                <Button Content="Reanudar partida" Command="{Binding Online.RejectScoreCommand}" IsVisible="{Binding Online.IsStoneRemoval}" />
                <Button Content="Salir" Command="{Binding Online.LeaveCommand}" ToolTip.Tip="Deja de mostrar la partida (sigue en OGS)" x:Name="LeaveButton" />
              </WrapPanel>
            </StackPanel>
          </Panel>
        </Border>

        <!-- Analysis: territory summary, engine evaluation of the last move, score graph. -->
        <Border Grid.Row="1" Classes="analysis" x:Name="AnalysisPanel"
                IsVisible="{Binding Analysis.IsAnalysisOn}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Analysis.Analysis, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Analysis.WinrateText}" FontWeight="SemiBold" x:Name="WinrateText" />
              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Analysis.LeadText}" VerticalAlignment="Center" x:Name="LeadText" />
            </Grid>
            <ProgressBar Classes="winrate" Minimum="0" Maximum="1" Value="{Binding Analysis.BlackWinrate}"
                         IsVisible="{Binding Analysis.Analysis, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="assessment" Classes.good="{Binding Analysis.AssessmentClass, Converter={x:Static c:StringEqualsConverter.Instance}, ConverterParameter=good}"
                       Classes.ok="{Binding Analysis.AssessmentClass, Converter={x:Static c:StringEqualsConverter.Instance}, ConverterParameter=ok}"
                       Classes.warn="{Binding Analysis.AssessmentClass, Converter={x:Static c:StringEqualsConverter.Instance}, ConverterParameter=warn}"
                       Classes.bad="{Binding Analysis.AssessmentClass, Converter={x:Static c:StringEqualsConverter.Instance}, ConverterParameter=bad}"
                       Text="{Binding Analysis.AssessmentText}" TextWrapping="Wrap" x:Name="AssessmentText"
                       IsVisible="{Binding Analysis.AssessmentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="secondary" Text="{Binding Analysis.BestText}" TextWrapping="Wrap"
                       IsVisible="{Binding Analysis.BestText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <c:ScoreGraph Height="64" Values="{Binding Analysis.Graph}" CurrentIndex="{Binding Analysis.GraphIndex}"
                          LineBrush="{DynamicResource Text.Primary}" Accent="{DynamicResource Accent}"
                          MoveClickedCommand="{Binding Analysis.GoToMoveCommand}" x:Name="ScoreGraph"
                          ToolTip.Tip="Ventaja estimada de negras por jugada (arriba = negras). Clic para ir a esa jugada." />
            <TextBlock Classes="secondary" Text="{Binding Analysis.StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}"
                       IsVisible="{Binding Analysis.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="AnalysisStatus" />
            <TextBlock Classes="secondary" Text="{Binding Analysis.TerritoryText}" TextWrapping="Wrap" x:Name="TerritoryText"
                       IsVisible="{Binding Analysis.TerritoryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="analysis" IsVisible="{Binding !Analysis.IsAnalysisOn}">
          <StackPanel IsVisible="{Binding Analysis.IsTerritoryOn}" Spacing="4">
            <TextBlock Classes="secondary" Text="{Binding Analysis.TerritoryText}" TextWrapping="Wrap"
                       IsVisible="{Binding Analysis.TerritoryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="secondary" Text="{Binding Analysis.StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}"
                       IsVisible="{Binding Analysis.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" x:Name="TreeScroll">
          <c:GameTreeControl x:Name="GameTree"
                             Root="{Binding Game.Tree.Root}"
                             Current="{Binding Game.CurrentNode}"
                             Version="{Binding Game.TreeVersion}"
                             BoardSize="{Binding Game.Board.Width}"
                             NodeClickedCommand="{Binding Game.GoToNodeCommand}"
                             HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>

        <GridSplitter Grid.Row="3" Height="3" Background="{DynamicResource Border.Subtle}" ResizeDirection="Rows" />

        <Border Grid.Row="4" Classes="properties-header">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="secondary" Text="{Binding Game.StatusText}" TextTrimming="CharacterEllipsis" x:Name="StatusText" />
            <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Game.MoveNumberText}" Margin="8,0,0,0" x:Name="MoveNumber" />
          </Grid>
        </Border>

        <TextBox Grid.Row="5" x:Name="CommentBox" Classes="comment" IsVisible="{Binding IsLocal}"
                 AcceptsReturn="True" TextWrapping="Wrap" Watermark="Comentario"
                 Text="{Binding Game.Comment}" />

        <DockPanel Grid.Row="5" x:Name="ChatPanel" Classes="appear" Background="{DynamicResource Bg.Properties}" IsVisible="{Binding IsOnline}">
          <TextBox DockPanel.Dock="Bottom" Classes="comment" Watermark="Escribe al rival (Enter)" Text="{Binding Online.ChatInput}" x:Name="ChatInput">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding Online.SendChatCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ListBox ItemsSource="{Binding Online.ChatLines}" Background="Transparent" x:Name="ChatList">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatLineItem">
                <StackPanel>
                  <TextBlock Classes="secondary" Text="{Binding Header}" />
                  <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>
  </Grid>
</Window>
