<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoshi.App.ViewModels"
             xmlns:c="using:Hoshi.App.Controls"
             xmlns:l="using:Hoshi.App.Localization"
             x:Class="Hoshi.App.Views.ChatView"
             x:DataType="vm:MainWindowViewModel">
  <!-- Part of the main window, shared with the phone layout. -->
  <DockPanel>
          <!-- Header: title and mute. -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8,8,4">
            <TextBlock Classes="secondary" FontSize="12" FontWeight="SemiBold" Text="{l:T Online.Chat}" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="bar" Padding="8,2" FontSize="12" IsChecked="{Binding Online.IsChatMuted}" x:Name="ChatMute"
                          Content="{l:T Online.ChatMute}" ToolTip.Tip="{l:T Online.ChatMuteTip}" />
          </Grid>
          <TextBox DockPanel.Dock="Bottom" Classes="comment" Watermark="{l:T Main.ChatHint}" Text="{Binding Online.ChatInput}" x:Name="ChatInput" MaxLength="500">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding Online.SendChatCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <!-- Quick phrases: sent in every language, each player reads their own. -->
          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Online.QuickPhrases}" Margin="8,2,8,6" x:Name="QuickPhrases">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuickPhrase">
                <Button Classes="chip" Content="{Binding Text}" Margin="0,0,6,4" Padding="8,3" FontSize="11.5"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Online.SendQuickPhraseCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Panel>
            <TextBlock Classes="secondary" Text="{l:T Online.ChatEmpty}" IsVisible="{Binding Online.IsChatEmpty}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" TextAlignment="Center" FontSize="12.5" />
            <TextBlock Classes="secondary" Text="{Binding Online.MutedText}" IsVisible="{Binding Online.IsChatMuted}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" TextAlignment="Center" FontSize="12.5" x:Name="ChatMutedText" />
            <ListBox ItemsSource="{Binding Online.ChatLines}" Background="Transparent" x:Name="ChatList" IsVisible="{Binding !Online.IsChatMuted}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="8,3" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatLineItem">
                  <Border Classes="chat-line" Classes.mine="{Binding IsMine}" CornerRadius="8" Padding="9,5" MaxWidth="300"
                          HorizontalAlignment="{Binding IsMine, Converter={x:Static c:BoolToAlignmentConverter.Instance}}">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="secondary" Text="{Binding Header}" FontSize="11" />
                      <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        
  </DockPanel>
</UserControl>
