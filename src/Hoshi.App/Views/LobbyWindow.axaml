<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hoshi.App.ViewModels"
        x:Class="Hoshi.App.Views.LobbyWindow"
        x:DataType="vm:LobbyViewModel"
        x:Name="Root"
        Title="Jugar en línea"
        Width="640" Height="560" MinWidth="520" MinHeight="420"
        Background="{DynamicResource Bg.Window}"
        WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding #Root.CloseCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshGamesCommand}" />
  </Window.KeyBindings>
  <Window.Resources>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{StaticResource Accent.Color}" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.beta">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <!-- Header: server, connection, user -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
      <Border Classes="badge" Classes.beta="{Binding IsBeta}">
        <TextBlock Text="{Binding ServerName}" FontSize="{DynamicResource Font.Size.Small}" />
      </Border>
      <TextBlock Grid.Column="1" Classes="secondary" Margin="10,0" VerticalAlignment="Center"
                 Text="{Binding ConnectionText}" x:Name="ConnectionLabel" />
      <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"
                 Text="{Binding UserText}" IsVisible="{Binding IsSignedIn}" x:Name="UserLabel" />
      <Button Grid.Column="4" Content="Cerrar sesión" Command="{Binding SignOutCommand}"
              IsVisible="{Binding IsSignedIn}" x:Name="SignOutButton" />
    </Grid>

    <!-- Footer: errors and status -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="2">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="ErrorLabel" />
      <TextBlock Text="{Binding StatusMessage}" Classes="secondary" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="StatusLabel" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2" />
    </StackPanel>

    <Panel>
      <!-- Signed out -->
      <StackPanel IsVisible="{Binding IsSignedOut}" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Width="320" Spacing="10" x:Name="SignInPanel">
        <TextBlock Text="Inicia sesión en OGS" FontSize="18" HorizontalAlignment="Center" />
        <StackPanel IsVisible="{Binding IsOAuthMode}" Spacing="10">
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Continuar con Google" Command="{Binding SignInWithGoogleCommand}" x:Name="GoogleSignInButton" />
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Iniciar sesión con OGS" Command="{Binding SignInCommand}" x:Name="BrowserSignInButton" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                     Text="Se abre tu navegador: entras en OGS (con Google o tu usuario) y autorizas a Hoshi. Hoshi nunca ve tus credenciales." />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsPasswordMode}" Spacing="8">
          <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                     Text="Modo de desarrollo (servidor beta). La contraseña se envía una sola vez y no se guarda." />
          <TextBox Watermark="Usuario" Text="{Binding Username}" x:Name="UsernameBox" />
          <TextBox Watermark="Contraseña" PasswordChar="•" Text="{Binding Password}" x:Name="PasswordBox">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Iniciar sesión" Command="{Binding SignInCommand}" x:Name="PasswordSignInButton" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" x:Name="SocialAccountHint"
                     Text="¿Tu cuenta usa Google? En beta hace falta una contraseña de OGS: ponle una en Configuración → Cuenta de beta.online-go.com, o crea una cuenta de pruebas. «Continuar con Google» está disponible con online-go.com." />
        </StackPanel>
      </StackPanel>

      <!-- Signed in -->
      <TabControl IsVisible="{Binding IsSignedIn}" x:Name="Tabs">
        <TabItem Header="Mis partidas">
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,8"
                    Content="Actualizar" Command="{Binding RefreshGamesCommand}" ToolTip.Tip="F5" />
            <Panel>
              <TextBlock Classes="secondary" Text="No tienes partidas en curso." HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding !ActiveGames.Count}" />
              <ListBox ItemsSource="{Binding ActiveGames}" x:Name="ActiveGamesList"
                       IsVisible="{Binding !!ActiveGames.Count}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActiveGameItem">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding Opponent}" />
                        <TextBlock Classes="secondary" Text="{Binding Game.Name}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Board}" VerticalAlignment="Center" Margin="12,0" />
                      <TextBlock Grid.Column="2" Text="{Binding TurnText}" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </DockPanel>
        </TabItem>

        <TabItem Header="Desafíos abiertos">
          <Panel Margin="0,8,0,0">
            <TextBlock Classes="secondary" Text="No hay desafíos abiertos ahora mismo." HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !OpenChallenges.Count}" />
            <ListBox ItemsSource="{Binding OpenChallenges}" x:Name="OpenChallengesList"
                     IsVisible="{Binding !!OpenChallenges.Count}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OpenChallengeItem">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Player}" />
                      <TextBlock Classes="secondary" Text="{Binding Details}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Board}" VerticalAlignment="Center" Margin="12,0" />
                    <Button Grid.Column="2" Content="Aceptar"
                            Command="{Binding #Root.((vm:LobbyViewModel)DataContext).AcceptCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Hoshi no acepta partidas clasificatorias" ToolTip.ShowOnDisabled="True" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </TabItem>

        <TabItem Header="Crear desafío">
          <StackPanel Margin="0,12,0,0" Spacing="10" MaxWidth="440" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" x:Name="ChallengeForm"
                  IsEnabled="{Binding !IsWaiting}">
              <Grid.Styles>
                <Style Selector="ComboBox, TextBox, NumericUpDown">
                  <Setter Property="Margin" Value="0,3" />
                  <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
              </Grid.Styles>
              <TextBlock Classes="label" Text="Rival" />
              <TextBox Grid.Column="1" Text="{Binding OpponentUsername}" Watermark="Vacío = desafío abierto" x:Name="OpponentBox" />

              <TextBlock Grid.Row="1" Classes="label" Text="Tablero" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BoardSizes}" SelectedItem="{Binding BoardSize}" />

              <TextBlock Grid.Row="2" Classes="label" Text="Tiempo" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TimePresets}" SelectedItem="{Binding SelectedTimePreset}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimePreset"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="3" Classes="label" Text="Color" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ColorChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="4" Classes="label" Text="Reglas" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RulesChoices}" SelectedItem="{Binding SelectedRules}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RulesChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="5" Classes="label" Text="Hándicap" />
              <NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="9" Increment="1" FormatString="0"
                             Value="{Binding Handicap}" />
            </Grid>
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="Las partidas creadas desde Hoshi son siempre no clasificatorias. Un desafío directo es privado." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="Crear desafío" Command="{Binding CreateChallengeCommand}" x:Name="CreateChallengeButton" />
              <Button Content="Cancelar desafío" Command="{Binding CancelWaitingCommand}" IsVisible="{Binding IsWaiting}" x:Name="CancelWaitingButton" />
            </StackPanel>
            <TextBlock Text="{Binding WaitingText}" IsVisible="{Binding IsWaiting}" Foreground="{DynamicResource Accent}" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Automatch">
          <TextBlock Classes="secondary" Margin="0,24" HorizontalAlignment="Center" TextWrapping="Wrap"
                     Text="El emparejamiento automático llegará junto con el tablero en línea (fase 5)." />
        </TabItem>
      </TabControl>
    </Panel>
  </DockPanel>
</Window>
