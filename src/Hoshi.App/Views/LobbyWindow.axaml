<Window Icon="/Assets/hoshi.ico"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Hoshi.App.Views"
        xmlns:l="using:Hoshi.App.Localization"
        xmlns:vm="using:Hoshi.App.ViewModels"
        x:Class="Hoshi.App.Views.LobbyWindow"
        x:DataType="vm:LobbyViewModel"
        x:Name="Root"
        Title="{l:T Lobby.Title}"
        Width="640" Height="560" MinWidth="520" MinHeight="420"
        Background="{DynamicResource Bg.Window}"
        WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding #Root.CloseCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshGamesCommand}" />
  </Window.KeyBindings>
  <v:LobbyView x:Name="View" />
</Window>
