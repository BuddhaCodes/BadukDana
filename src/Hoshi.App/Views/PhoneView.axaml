<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Hoshi.App.ViewModels"
             xmlns:v="using:Hoshi.App.Views"
             xmlns:c="using:Hoshi.App.Controls"
             xmlns:sys="using:System"
             xmlns:l="using:Hoshi.App.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="860"
             x:Class="Hoshi.App.Views.PhoneView"
             x:DataType="vm:PhoneShellViewModel"
             Background="{DynamicResource Bg.Surround}">
  <!-- The phone layout (Android): the board on top, one sheet at a time below it, and a bar of buttons.
       Windows of the desktop open here as full-screen pages; dialogs as a card. -->
  <UserControl.Styles>
    <Style Selector="Button.phone-bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Button.phone-bar.on">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.phone-bar TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Button.phone-bar:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.menu-item:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.phone-bar:disabled, Button.menu-item:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.menu-item">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Button.home-card, Button.home-tile">
      <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.home-tile"><Setter Property="Margin" Value="4,0,4,8" /><Setter Property="MinHeight" Value="104" /></Style>
    <Style Selector="TextBlock.home-glyph">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Brand}" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBlock.home-kicker">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBlock.home-section">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Title}" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button.home-size">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.home-round">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Players as two cards; the one to move is lit. -->
    <Style Selector="Border.player-card">
      <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.player-card.turn"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" /></Style>
    <Style Selector="v|OnlinePanelView.actions-only Grid#OnlineNames"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="v|OnlinePanelView.actions-only TextBlock#OnlineStatus"><Setter Property="IsVisible" Value="False" /></Style>
  </UserControl.Styles>

  <LayoutTransformControl LayoutTransform="{Binding Main.UiScaleTransform}" x:Name="UiScaleRoot">
  <Panel>
    <c:ThemeBackground Kind="{DynamicResource Theme.Background}" Animate="False" />
    <DockPanel x:Name="Shell">

      <!-- Top: players and the turn (local), or the online panel with clocks and actions. -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
              Padding="14,10,14,8" x:Name="PhoneTop">
        <Panel>
          <StackPanel Spacing="4" IsVisible="{Binding Main.IsLocal}">
            <!-- Two player cards (redesign 2026-10): stone, name, captures and clock; the one to move is lit. -->
            <Grid ColumnDefinitions="*,8,*">
              <Border Classes="player-card" Classes.turn="{Binding Main.Game.IsBlackToMove}" x:Name="PhoneBlackCard">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Ellipse Width="16" Height="16" Fill="#141414" Stroke="#9A9A9A" StrokeThickness="1" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Main.Game.BlackName}" TextTrimming="CharacterEllipsis" FontSize="13.5"
                               FontWeight="{Binding Main.Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" x:Name="PhoneBlackName" />
                    <TextBlock Classes="secondary" FontSize="11.5" Text="{Binding Main.Game.Board.WhiteCaptures, StringFormat='+{0}'}"
                               IsVisible="{Binding Main.Game.Board.WhiteCaptures}" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="clock" Classes.low="{Binding Main.Clock.IsBlackLow}" IsVisible="{Binding Main.Clock.HasClock}" x:Name="PhoneBlackClock" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Main.Clock.BlackText}" />
                  </Border>
                </Grid>
              </Border>
              <Border Grid.Column="2" Classes="player-card" Classes.turn="{Binding !Main.Game.IsBlackToMove}" x:Name="PhoneWhiteCard">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Ellipse Width="16" Height="16" Fill="#F2F2EE" Stroke="#888" StrokeThickness="1" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Main.Game.WhiteName}" TextTrimming="CharacterEllipsis" FontSize="13.5"
                               FontWeight="{Binding !Main.Game.IsBlackToMove, Converter={x:Static c:BoolToFontWeightConverter.Instance}}" />
                    <TextBlock Classes="secondary" FontSize="11.5" Text="{Binding Main.Game.Board.BlackCaptures, StringFormat='+{0}'}"
                               IsVisible="{Binding Main.Game.Board.BlackCaptures}" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="clock" Classes.low="{Binding Main.Clock.IsWhiteLow}" IsVisible="{Binding Main.Clock.HasClock}" x:Name="PhoneWhiteClock" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Main.Clock.WhiteText}" />
                  </Border>
                </Grid>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="secondary" FontSize="12" Text="{Binding Main.Game.StatusText}" TextTrimming="CharacterEllipsis" x:Name="PhoneStatus" />
              <TextBlock Grid.Column="1" Classes="secondary" FontSize="12" Text="{Binding Main.Game.MoveNumberText}" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
          <!-- Online (redesign 2026-10): the opponent's card here, yours under the board; the actions stay below it. -->
          <StackPanel IsVisible="{Binding Main.IsOnline}" Spacing="6" x:Name="PhoneOnline">
            <Border Classes="player-card" Classes.turn="{Binding TopCard.IsToMove, FallbackValue=False}" IsVisible="{Binding TopCard, Converter={x:Static ObjectConverters.IsNotNull}}" x:Name="PhoneTopCard">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Panel VerticalAlignment="Center">
                  <Ellipse Width="20" Height="20" Fill="#141414" Stroke="#9A9A9A" StrokeThickness="1" IsVisible="{Binding TopCard.IsBlack, FallbackValue=False}" />
                  <Ellipse Width="20" Height="20" Fill="#F2F2EE" Stroke="#888" StrokeThickness="1" IsVisible="{Binding !TopCard.IsBlack, FallbackValue=False}" />
                </Panel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TopCard.Name, FallbackValue={x:Null}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="secondary" FontSize="11.5" Text="{Binding TopCard.CapturesText, FallbackValue={x:Null}}" />
                </StackPanel>
                <Border Grid.Column="2" Classes="clock" Classes.low="{Binding TopCard.IsClockLow, FallbackValue=False}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TopCard.Clock, FallbackValue={x:Null}}" FontSize="17" />
                </Border>
              </Grid>
            </Border>
            <TextBlock Classes="secondary" FontSize="12" Text="{Binding Main.Online.StatusText, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" x:Name="PhoneOnlineStatus" />
          </StackPanel>
        </Panel>
      </Border>

      <!-- Bottom bar: navigation, the game's actions and the sheets; the confirm bar takes its place while a stone
           waits, at the same height, so the board does not move between the two taps. -->
      <Panel DockPanel.Dock="Bottom" IsVisible="{Binding !Main.IsZen}" x:Name="PhoneBarHost">
      <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
              x:Name="PhoneBar" IsVisible="{Binding !Main.IsZen}">
        <UniformGrid Rows="1">
          <Button Classes="phone-bar" Command="{Binding Main.Game.GoBackCommand}" ToolTip.Tip="{l:T Main.Previous}" x:Name="PhonePrevious">
            <c:HoshiIcon Icon="{DynamicResource Icon.Previous}" Size="22" />
          </Button>
          <Button Classes="phone-bar" Command="{Binding Main.Game.GoForwardCommand}" ToolTip.Tip="{l:T Main.Next}" x:Name="PhoneNext">
            <c:HoshiIcon Icon="{DynamicResource Icon.Next}" Size="22" />
          </Button>
          <Button Classes="phone-bar" Command="{Binding Main.Game.PassCommand}" IsVisible="{Binding Main.IsLocal}" x:Name="PhonePass">
            <StackPanel><c:HoshiIcon Icon="{DynamicResource Icon.Pass}" Size="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T Main.Pass}" /></StackPanel>
          </Button>
          <Button Classes="phone-bar" Command="{Binding Main.Game.UndoCommand}" IsVisible="{Binding Main.IsLocal}" x:Name="PhoneUndo">
            <StackPanel><c:HoshiIcon Icon="{DynamicResource Icon.Undo}" Size="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T Main.Undo}" /></StackPanel>
          </Button>
          <Button Classes="phone-bar" Classes.on="{Binding IsMoves}" Command="{Binding ToggleSheetCommand}" CommandParameter="{x:Static vm:PhoneSheet.Moves}" x:Name="PhoneMoves">
            <StackPanel><c:HoshiIcon Icon="{DynamicResource Icon.Moves}" Size="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T Phone.Moves}" /></StackPanel>
          </Button>
          <Button Classes="phone-bar" Classes.on="{Binding IsAnalysis}" Command="{Binding ToggleSheetCommand}" CommandParameter="{x:Static vm:PhoneSheet.Analysis}"
                  IsVisible="{Binding !Main.Analysis.IsBlocked}" x:Name="PhoneAnalysis">
            <StackPanel><c:HoshiIcon Icon="{DynamicResource Icon.Analysis}" Size="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T Main.Analysis}" /></StackPanel>
          </Button>
          <Button Classes="phone-bar" Classes.on="{Binding IsChat}" Command="{Binding ToggleSheetCommand}" CommandParameter="{x:Static vm:PhoneSheet.Chat}"
                  IsVisible="{Binding Main.IsOnline}" x:Name="PhoneChat">
            <StackPanel><c:HoshiIcon Icon="{DynamicResource Icon.Chat}" Size="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T Online.Chat}" /></StackPanel>
          </Button>
          <Button Classes="phone-bar" Classes.on="{Binding IsStudy}" Command="{Binding ToggleSheetCommand}" CommandParameter="{x:Static vm:PhoneSheet.Study}" x:Name="PhoneStudy">
            <StackPanel><c:HoshiIcon Icon="{DynamicResource Icon.Study}" Size="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T Main.Study}" /></StackPanel>
          </Button>
          <Button Classes="phone-bar" Classes.on="{Binding IsMenu}" Command="{Binding ToggleSheetCommand}" CommandParameter="{x:Static vm:PhoneSheet.Menu}" x:Name="PhoneMenu">
            <c:HoshiIcon Icon="{DynamicResource Icon.Menu}" Size="22" />
          </Button>
        </UniformGrid>
      </Border>
      <!-- Tap and confirm: the waiting stone's coordinate, and play it or not. -->
      <Border IsVisible="{Binding Main.Game.HasPendingMove}" x:Name="PhoneConfirmBar"
              Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,1,0,0" Padding="14,4">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Classes="secondary" FontSize="12.5" Text="{l:T Phone.ConfirmHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{l:T Study.CancelEdit}" Command="{Binding Main.Game.CancelPendingCommand}" MinHeight="40" VerticalContentAlignment="Center" />
          <Button Grid.Column="2" Classes="accent" Command="{Binding Main.Game.ConfirmPendingCommand}" MinHeight="40" VerticalContentAlignment="Center" x:Name="PhoneConfirm">
            <TextBlock Text="{Binding Main.Game.ConfirmPendingLabel}" FontWeight="SemiBold" />
          </Button>
        </Grid>
      </Border>
      </Panel>


      <!-- Online: your card and the game's actions, under the board. -->
      <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding Main.IsOnline}" Spacing="6" Margin="14,6,14,6" x:Name="PhoneOnlineBottom">
        <Border Classes="player-card" Classes.turn="{Binding BottomCard.IsToMove, FallbackValue=False}" IsVisible="{Binding BottomCard, Converter={x:Static ObjectConverters.IsNotNull}}" x:Name="PhoneBottomCard">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Panel VerticalAlignment="Center">
                  <Ellipse Width="20" Height="20" Fill="#141414" Stroke="#9A9A9A" StrokeThickness="1" IsVisible="{Binding BottomCard.IsBlack, FallbackValue=False}" />
                  <Ellipse Width="20" Height="20" Fill="#F2F2EE" Stroke="#888" StrokeThickness="1" IsVisible="{Binding !BottomCard.IsBlack, FallbackValue=False}" />
                </Panel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding BottomCard.Name, FallbackValue={x:Null}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="secondary" FontSize="11.5" Text="{Binding BottomCard.CapturesText, FallbackValue={x:Null}}" />
                </StackPanel>
                <Border Grid.Column="2" Classes="clock" Classes.low="{Binding BottomCard.IsClockLow, FallbackValue=False}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding BottomCard.Clock, FallbackValue={x:Null}}" FontSize="17" />
                </Border>
              </Grid>
            </Border>
        <v:OnlinePanelView DataContext="{Binding Main}" Classes="actions-only" x:Name="PhoneOnlineActions" />
      </StackPanel>

      <!-- The sheet under the board. -->
      <!-- Portrait: the sheet is under the board (its handle sets the height). Landscape (tablets, phones turned): on the right. -->
      <Border DockPanel.Dock="{Binding SheetDock}" IsVisible="{Binding HasSheet}" Height="{Binding SheetHeightValue}" Width="{Binding SheetWidthValue}"
              Background="{DynamicResource Bg.Properties}"
              BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="{Binding SheetBorder}" Classes="appear" x:Name="PhoneSheet">
        <DockPanel>
        <!-- The handle: drag it to make the sheet taller or shorter; dragged almost away, the sheet closes. -->
        <Border DockPanel.Dock="Top" Height="22" Background="Transparent" Cursor="SizeNorthSouth" ToolTip.Tip="{l:T Phone.Resize}" x:Name="PhoneSheetHandle"
                IsVisible="{Binding !IsLandscape}">
          <Border Width="40" Height="4" CornerRadius="2" Background="{DynamicResource Border.Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Panel>
          <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsMoves}" x:Name="PhoneMovesSheet">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <c:GameTreeControl Verdicts="{Binding Main.Analysis.NodeVerdicts}" Root="{Binding Main.Game.Tree.Root}" Current="{Binding Main.Game.CurrentNode}" Version="{Binding Main.Game.TreeVersion}"
                                 BoardSize="{Binding Main.Game.Board.Width}" NodeClickedCommand="{Binding Main.Game.GoToNodeCommand}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" />
            </ScrollViewer>
            <TextBox Grid.Row="1" Classes="comment" Height="96" AcceptsReturn="True" TextWrapping="Wrap" Watermark="{l:T Main.Comment}"
                     Text="{Binding Main.Game.Comment}" IsVisible="{Binding Main.IsLocal}" x:Name="PhoneComment" />
          </Grid>
          <ScrollViewer IsVisible="{Binding IsAnalysis}" VerticalScrollBarVisibility="Auto">
            <Border Classes="analysis">
              <v:AnalysisPanelView DataContext="{Binding Main}" />
            </Border>
          </ScrollViewer>
          <Border IsVisible="{Binding IsStudy}" x:Name="PhoneStudySheet">
            <v:StudyPanelView DataContext="{Binding Main}" />
          </Border>
          <Border IsVisible="{Binding IsChat}" x:Name="PhoneChatSheet">
            <v:ChatView DataContext="{Binding Main}" />
          </Border>
          <!-- The phone menu, in groups: new game, play, study, this game, share (folded), settings. -->
          <ScrollViewer IsVisible="{Binding IsMenu}" x:Name="PhoneMenuSheet">
            <StackPanel Margin="0,4,0,8">
              <Button Classes="menu-item" Command="{Binding ShowHomeCommand}" x:Name="MenuHome">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Back}" Size="18" /><TextBlock Text="{l:T Home.Menu}" /></StackPanel>
              </Button>
              <TextBlock Classes="menu-section" Text="{l:T Menu.NewGame}" />
              <UniformGrid Columns="3" Margin="12,0,12,6">
                <UniformGrid.Styles><Style Selector="Button"><Setter Property="Margin" Value="3" /><Setter Property="MinHeight" Value="44" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style></UniformGrid.Styles>
                <Button Command="{Binding Main.Game.NewGameCommand}" x:Name="MenuNew19"><Button.CommandParameter><sys:Int32>19</sys:Int32></Button.CommandParameter><TextBlock Text="19×19" /></Button>
                <Button Command="{Binding Main.Game.NewGameCommand}"><Button.CommandParameter><sys:Int32>13</sys:Int32></Button.CommandParameter><TextBlock Text="13×13" /></Button>
                <Button Command="{Binding Main.Game.NewGameCommand}"><Button.CommandParameter><sys:Int32>9</sys:Int32></Button.CommandParameter><TextBlock Text="9×9" /></Button>
              </UniformGrid>
              <Button Classes="menu-item" Command="{Binding Main.PlayEngineCommand}" x:Name="MenuPlayKataGo">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Engine}" Size="18" /><TextBlock Text="{l:T Phone.PlayKataGo}" /></StackPanel>
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.OpenLobbyCommand}" x:Name="MenuOnline">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Online}" Size="18" /><TextBlock Text="{l:T Main.PlayOnline}" /></StackPanel>
              </Button>
              <TextBlock Classes="menu-section" Text="{l:T Menu.Study}" />
              <Button Classes="menu-item" Command="{Binding Main.OpenTsumegoCommand}" x:Name="MenuTsumego">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Quiz}" Size="18" /><TextBlock Text="{l:T Tsumego.Menu}" /></StackPanel>
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.OpenReplaysCommand}" x:Name="MenuReplays">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Moves}" Size="18" /><TextBlock Text="{l:T Main.Replays}" /></StackPanel>
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.AnnotateReviewCommand}" x:Name="MenuReview">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Analysis}" Size="18" /><TextBlock Text="{l:T Review.Menu}" /></StackPanel>
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Counting.StartCommand}" x:Name="MenuCount" IsVisible="{Binding Main.IsLocal}">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Territory}" Size="18" /><TextBlock Text="{l:T Count.Menu}" /></StackPanel>
              </Button>
              <!-- The clock: only for games on this device (online games use the server's clock). -->
              <StackPanel Margin="14,8,14,4" Spacing="6" x:Name="MenuClock" IsVisible="{Binding Main.IsLocal}">
                <TextBlock Text="{l:T Clock.Menu}" Classes="secondary" />
                <WrapPanel Orientation="Horizontal">
                  <WrapPanel.Styles><Style Selector="Button"><Setter Property="Margin" Value="0,0,6,6" /><Setter Property="MinHeight" Value="40" /></Style></WrapPanel.Styles>
                  <Button Content="{Binding Main.Clock.Presets[0].Name}" Command="{Binding Main.Clock.StartCommand}" CommandParameter="{Binding Main.Clock.Presets[0]}" />
                  <Button Content="{Binding Main.Clock.Presets[1].Name}" Command="{Binding Main.Clock.StartCommand}" CommandParameter="{Binding Main.Clock.Presets[1]}" />
                  <Button Content="{Binding Main.Clock.Presets[2].Name}" Command="{Binding Main.Clock.StartCommand}" CommandParameter="{Binding Main.Clock.Presets[2]}" />
                  <Button Content="{Binding Main.Clock.Presets[4].Name}" Command="{Binding Main.Clock.StartCommand}" CommandParameter="{Binding Main.Clock.Presets[4]}" />
                  <Button Content="{Binding Main.PauseGameLabel}" Command="{Binding Main.TogglePauseGameCommand}" IsVisible="{Binding Main.CanPauseGame}" />
                  <Button Content="{l:T Clock.Remove}" Command="{Binding Main.Clock.RemoveCommand}" IsVisible="{Binding Main.Clock.HasClock}" />
                </WrapPanel>
              </StackPanel>
              <TextBlock Classes="menu-section" Text="{l:T Menu.ThisGame}" />
              <Button Classes="menu-item" Command="{Binding Main.Game.OpenCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Folder}" Size="18" /><TextBlock Text="{l:T Main.Open}" /></StackPanel>
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Game.SaveAsCommand}">
                <TextBlock Text="{l:T Main.SaveAs}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Game.EditGameInfoCommand}">
                <TextBlock Text="{l:T Main.GameInfo}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Analysis.ToggleTerritoryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Territory}" Size="18" /><TextBlock Text="{l:T Main.Territory}" /></StackPanel>
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.ToggleZenCommand}" x:Name="MenuZen">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Star}" Size="18" /><TextBlock Text="{l:T Zen.Menu}" /></StackPanel>
              </Button>
              <Expander Header="{l:T Share.Menu}" Margin="6,4" HorizontalAlignment="Stretch" x:Name="MenuShare">
                <StackPanel>
              <Button Classes="menu-item" Command="{Binding Main.Share.ShareImageCommand}" x:Name="MenuShareImage">
                <TextBlock Text="{l:T Share.ShareImage}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Share.ShareAnimationCommand}" x:Name="MenuShareAnimation">
                <TextBlock Text="{l:T Share.ShareAnimation}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Share.ExportCardCommand}" CommandParameter="Story" x:Name="MenuShareCard">
                <TextBlock Text="{l:T Share.Card}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Share.ExportProblemCommand}" x:Name="MenuShareProblem">
                <TextBlock Text="{l:T Share.Problem}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Share.ExportSummaryCommand}" CommandParameter="Month" IsVisible="{Binding Main.Share.HasSummary}" x:Name="MenuShareSummary">
                <TextBlock Text="{l:T Share.Summary}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Share.ShareWebViewerCommand}" x:Name="MenuShareViewer">
                <TextBlock Text="{l:T Share.WebViewer}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Share.CopySgfCommand}" x:Name="MenuShareSgf">
                <TextBlock Text="{l:T Share.ShareSgf}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Share.PasteSgfCommand}" x:Name="MenuPasteSgf">
                <TextBlock Text="{l:T Share.PasteSgf}" Margin="28,0,0,0" />
              </Button>
                </StackPanel>
              </Expander>
              <TextBlock Classes="menu-section" Text="{l:T Menu.Settings}" />
              <Button Classes="menu-item" Command="{Binding Main.OpenPreferencesCommand}" x:Name="MenuPreferences">
                <StackPanel Orientation="Horizontal" Spacing="10"><c:HoshiIcon Icon="{DynamicResource Icon.Settings}" Size="18" /><TextBlock Text="{l:T Main.Preferences}" /></StackPanel>
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Welcome.OpenCommand}" x:Name="MenuWelcome">
                <TextBlock Text="{l:T Welcome.Menu}" Margin="28,0,0,0" />
              </Button>
              <Button Classes="menu-item" Command="{Binding Main.Updates.SupportCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding Main.Updates, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{l:T Support.Menu}" Margin="28,0,0,0" />
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Panel>
        </DockPanel>
      </Border>

      <!-- The board. -->
      <Panel x:Name="PhoneBoardArea">
        <c:GoBoardControl x:Name="Board" AutomationProperties.Name="{Binding Main.Game.BoardDescription}" AutomationProperties.LiveSetting="Polite"
                          Margin="6"
                          ShowCoordinates="{Binding Main.ShowCoordinates}"
                          MoveNumbers="{Binding Main.Game.MoveNumberLabels}"
                          JosekiHints="{Binding Main.JosekiHints.Hints}"
                          Board="{Binding Main.Game.Board}"
                          BoardStyle="{DynamicResource Theme.Board}"
                          Territory="{Binding Main.BoardTerritory}"
                          Suggestions="{Binding Main.Analysis.BoardSuggestions}"
                          Impact="{Binding Main.Analysis.Impact}"
                          Effects="{Binding Main.BoardEffects}"
                          GroupStatuses="{Binding Main.Analysis.GroupStatuses}"
                          Animate="{DynamicResource Theme.Animations}"
                          LastMove="{Binding Main.Game.LastMove}"
                          Markers="{Binding Main.Game.Markers}"
                          HoverPoint="{Binding Main.Game.HoverPoint}"
                          GhostStone="{Binding Main.Study.GhostStone}"
                          PendingPoint="{Binding Main.Game.PendingMove}"
                          PendingStone="{Binding Main.Game.PendingStone}"
                          StudyDrawings="{Binding Main.Study.BoardDrawings}"
                          PendingDrawingIds="{Binding Main.Study.PendingDrawingIds}"
                          DragPreview="{Binding Main.Study.DragPreview}"
                          DragColor="{Binding Main.Study.Color}"
                          PointClickedCommand="{Binding Main.Study.BoardClickCommand}"
                          PointDraggedCommand="{Binding Main.Study.BoardDragCommand}" />
        <!-- Counting at the end of a local game: the result, and accept or keep playing. -->
        <Border x:Name="PhoneCountingCard" IsVisible="{Binding Main.Counting.IsActive}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,8"
                MaxWidth="460" Padding="14,10" CornerRadius="12" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Main.Counting.ResultText}" FontWeight="SemiBold" FontSize="15" x:Name="PhoneCountingCardResult" />
            <TextBlock Classes="secondary" Text="{Binding Main.Counting.DetailText}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Classes="secondary" Text="{l:T Count.Hint}" TextWrapping="Wrap" FontSize="11.5" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{l:T Count.KeepPlaying}" Command="{Binding Main.Counting.KeepPlayingCommand}" MinHeight="36" VerticalContentAlignment="Center" />
              <Button Classes="accent" Content="{l:T Count.Accept}" Command="{Binding Main.Counting.AcceptCommand}" MinHeight="36" VerticalContentAlignment="Center" x:Name="PhoneCountingCardAccept" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- The first-start tour (and the menu's "Welcome tour"). -->
        <Border x:Name="PhoneWelcomeCard" IsVisible="{Binding Main.Welcome.IsOpen}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                MaxWidth="440" Padding="22,18" CornerRadius="16" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1" BoxShadow="0 12 40 0 #80000000">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Main.Welcome.Title}" FontFamily="{DynamicResource Font.Title}" FontSize="21" TextWrapping="Wrap" x:Name="PhoneWelcomeCardTitle" />
              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Main.Welcome.StepText}" VerticalAlignment="Top" Margin="10,4,0,0" />
            </Grid>
            <TextBlock Text="{Binding Main.Welcome.Text}" TextWrapping="Wrap" LineHeight="21" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <Button Content="{l:T Welcome.Skip}" Command="{Binding Main.Welcome.CloseCommand}" IsVisible="{Binding !Main.Welcome.IsLast}" Classes="bar" />
              <Button Grid.Column="1" Content="{l:T Welcome.Rules}" Command="{Binding Main.Welcome.LearnRulesCommand}" IsVisible="{Binding Main.Welcome.IsLast}" HorizontalAlignment="Left" x:Name="PhoneWelcomeCardRules" />
              <Button Grid.Column="2" Content="{l:T Welcome.Back}" Command="{Binding Main.Welcome.BackCommand}" IsVisible="{Binding !Main.Welcome.IsFirst}" MinHeight="36" />
              <Button Grid.Column="3" Classes="accent" Command="{Binding Main.Welcome.NextCommand}" MinHeight="36" x:Name="PhoneWelcomeCardNext">
                <Panel>
                  <TextBlock Text="{l:T Welcome.Next}" IsVisible="{Binding !Main.Welcome.IsLast}" />
                  <TextBlock Text="{l:T Welcome.Done}" IsVisible="{Binding Main.Welcome.IsLast}" />
                </Panel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
        <!-- Your move in another OGS game: open it or dismiss. -->
        <Border x:Name="PhoneTurnCard" IsVisible="{Binding Main.TurnNotice, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="warmup"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Padding="12,6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Main.TurnNotice.Text, FallbackValue={x:Null}}" VerticalAlignment="Center" />
            <Button Classes="accent" Content="{l:T Turn.Open}" Command="{Binding Main.OpenTurnGameCommand}" MinHeight="32" VerticalContentAlignment="Center" x:Name="PhoneTurnCardOpen" />
            <Button Classes="bar icon" Command="{Binding Main.DismissTurnNoticeCommand}" VerticalAlignment="Center">
              <c:HoshiIcon Icon="{DynamicResource Icon.Close}" Size="12" />
            </Button>
          </StackPanel>
        </Border>
        <!-- Paused local game: the board waits. -->
        <Border x:Name="PhonePausedOverlay" IsVisible="{Binding Main.IsGamePaused}" Background="#99000000">
          <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{l:T Pause.Title}" FontSize="24" FontFamily="{DynamicResource Font.Title}" HorizontalAlignment="Center" Foreground="White" />
            <Button Classes="accent" Content="{l:T Pause.Resume}" Command="{Binding Main.TogglePauseGameCommand}" MinHeight="44" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <!-- A new version on the website: phones update by installing the new APK over this one. -->
        <Border x:Name="PhoneUpdateCard" IsVisible="{Binding Main.Updates.IsVisible, FallbackValue=False}" Classes="warmup"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,10" Padding="12,8" MaxWidth="420">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Main.Updates.Text, FallbackValue={x:Null}}" FontWeight="SemiBold" TextWrapping="Wrap" x:Name="PhoneUpdateText" />
            <TextBlock Classes="secondary" Text="{Binding Main.Updates.InstallerHint, FallbackValue={x:Null}}" TextWrapping="Wrap" FontSize="12.5" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{l:T Update.Later}" Command="{Binding Main.Updates.LaterCommand, FallbackValue={x:Null}}" />
              <Button Classes="accent" Content="{Binding Main.Updates.UpdateLabel, FallbackValue={x:Null}}" Command="{Binding Main.Updates.UpdateCommand, FallbackValue={x:Null}}" x:Name="PhoneUpdateButton" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Button x:Name="PhoneZenExit" IsVisible="{Binding Main.IsZen}" Command="{Binding Main.ToggleZenCommand}" Classes="zen-exit phone"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:HoshiIcon Icon="{DynamicResource Icon.Close}" Size="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{l:T Zen.Exit}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border Classes="warmup" IsHitTestVisible="False" IsVisible="{Binding Main.Study.IsQuizActive}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:HoshiIcon Icon="{DynamicResource Icon.Quiz}" Size="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Main.Study.QuizPrompt}" FontSize="12" IsVisible="{Binding Main.Study.CanReveal}" TextWrapping="Wrap" MaxWidth="300" />
            <TextBlock Text="{Binding Main.Study.QuizResult}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding !Main.Study.CanReveal}" TextWrapping="Wrap" MaxWidth="300" />
          </StackPanel>
        </Border>
        <Border Classes="warmup" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                Opacity="{Binding Main.Analysis.IsWarmingUp, Converter={x:Static c:BoolToOpacityConverter.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressBar IsIndeterminate="True" Width="40" MinWidth="40" Height="3" MinHeight="3" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Main.Analysis.WarmupText}" FontSize="12" MaxWidth="280" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Panel>
    </DockPanel>

    <!-- Home (redesign 2026-10): continue the game, a new one, or a mode. The board waits underneath. -->
    <DockPanel IsVisible="{Binding IsHome}" Background="{DynamicResource Bg.Window}" x:Name="PhoneHome">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="18,14,18,22">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Accent}">
              <TextBlock Text="星" FontFamily="{DynamicResource Font.Brand}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Bg.Window}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Hoshi" FontFamily="{DynamicResource Font.Title}" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Classes="secondary" Text="{l:T Home.Greeting}" FontSize="12.5" />
            </StackPanel>
            <Button Grid.Column="2" Classes="home-round" Command="{Binding Main.OpenPreferencesCommand}" ToolTip.Tip="{l:T Main.Preferences}" x:Name="HomePreferences">
              <c:HoshiIcon Icon="{DynamicResource Icon.Settings}" Size="20" />
            </Button>
          </Grid>

          <!-- The game on the board: a small picture of it, and back to it. -->
          <Button Classes="home-card" Command="{Binding ContinueGameCommand}" IsVisible="{Binding HasGameToContinue}" x:Name="HomeContinue">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <c:GoBoardControl Width="96" Height="96" IsHitTestVisible="False" Board="{Binding Main.Game.Board}" BoardStyle="{DynamicResource Theme.Board}"
                                LastMove="{Binding Main.Game.LastMove}" ShowCoordinates="False" x:Name="HomeBoard" />
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="home-kicker" Text="{l:T Home.YourGame}" />
                <TextBlock Text="{Binding ContinueTitle}" FontWeight="SemiBold" FontSize="15.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{Binding ContinueDetail}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{l:T Home.Continue}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </Button>

          <StackPanel Spacing="8">
            <TextBlock Classes="home-section" Text="{l:T Home.NewGame}" />
            <UniformGrid Columns="3" Margin="-4,0">
              <UniformGrid.Styles><Style Selector="Button"><Setter Property="Margin" Value="4,0" /></Style></UniformGrid.Styles>
              <Button Classes="home-size accent" Content="19×19" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.New19}" x:Name="HomeNew19" />
              <Button Classes="home-size" Content="13×13" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.New13}" />
              <Button Classes="home-size" Content="9×9" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.New9}" />
            </UniformGrid>
          </StackPanel>

          <StackPanel Spacing="8">
          <TextBlock Classes="home-section" Text="{l:T Home.Modes}" />
          <UniformGrid Columns="2" Margin="-4,0" x:Name="HomeTiles">
            <Button Classes="home-tile" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.Online}" x:Name="HomeTileOnline">
              <StackPanel Spacing="3">
                <TextBlock Classes="home-glyph" Text="序" />
                <TextBlock Text="{l:T Home.Online}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{l:T Home.OnlineDetail}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Classes="home-tile" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.KataGo}" x:Name="HomeTileKataGo">
              <StackPanel Spacing="3">
                <TextBlock Classes="home-glyph" Text="対" />
                <TextBlock Text="{l:T Home.KataGo}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{l:T Home.KataGoDetail}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Classes="home-tile" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.Problems}" x:Name="HomeTileProblems">
              <StackPanel Spacing="3">
                <TextBlock Classes="home-glyph" Text="詰" />
                <TextBlock Text="{l:T Home.Problems}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{l:T Home.ProblemsDetail}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Classes="home-tile" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.Study}" x:Name="HomeTileStudy">
              <StackPanel Spacing="3">
                <TextBlock Classes="home-glyph" Text="中" />
                <TextBlock Text="{l:T Home.Study}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{l:T Home.StudyDetail}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Classes="home-tile" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.Replays}" x:Name="HomeTileReplays">
              <StackPanel Spacing="3">
                <TextBlock Classes="home-glyph" Text="終" />
                <TextBlock Text="{l:T Home.Replays}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{l:T Home.ReplaysDetail}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Classes="home-tile" Command="{Binding HomeCommand}" CommandParameter="{x:Static vm:PhoneHomeAction.Open}" x:Name="HomeTileOpen">
              <StackPanel Spacing="3">
                <TextBlock Classes="home-glyph" Text="譜" />
                <TextBlock Text="{l:T Home.Open}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{l:T Home.OpenDetail}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </UniformGrid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- A page: Preferences, the lobby, the library, game info, play against KataGo. -->
    <DockPanel IsVisible="{Binding Navigation.HasPage}" Background="{DynamicResource Bg.Window}" x:Name="PhonePage">
      <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*">
          <Button Classes="phone-bar" Width="52" Command="{Binding Navigation.GoBackCommand}" ToolTip.Tip="{l:T Phone.Back}" x:Name="PhonePageBack">
            <c:HoshiIcon Icon="{DynamicResource Icon.Back}" Size="22" />
          </Button>
          <TextBlock Grid.Column="1" Text="{Binding Navigation.Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
      <ContentControl Content="{Binding Navigation.Page}" x:Name="PhonePageContent" />
    </DockPanel>

    <!-- A question or a message. -->
    <Border IsVisible="{Binding Navigation.HasMessage}" Background="#A0000000" x:Name="PhoneMessage">
      <Border Background="{DynamicResource Bg.Panel}" CornerRadius="14" Padding="20,18" Margin="24" VerticalAlignment="Center" MaxWidth="420"
              BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Navigation.Message.Title, FallbackValue={x:Null}}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Navigation.Message.Text, FallbackValue={x:Null}}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="{Binding Navigation.Message.NoLabel, FallbackValue={x:Null}}" Command="{Binding Navigation.NoCommand}"
                    IsVisible="{Binding Navigation.Message.IsConfirm, FallbackValue=False}" MinWidth="80" x:Name="PhoneMessageNo" />
            <Button Classes="accent" Content="{Binding Navigation.Message.OkLabel, FallbackValue={x:Null}}" Command="{Binding Navigation.YesCommand}" MinWidth="80"
                    x:Name="PhoneMessageOk" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
  </LayoutTransformControl>
</UserControl>
