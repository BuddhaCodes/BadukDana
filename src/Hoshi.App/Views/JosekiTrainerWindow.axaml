<Window Icon="/Assets/hoshi.ico"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Hoshi.App.Localization"
        xmlns:c="using:Hoshi.App.Controls"
        xmlns:vm="using:Hoshi.App.ViewModels"
        x:Class="Hoshi.App.Views.JosekiTrainerWindow"
        x:DataType="vm:JosekiTrainerViewModel"
        x:Name="Root"
        Title="{l:T Joseki.Title}"
        Width="980" Height="680" MinWidth="720" MinHeight="480"
        Background="{DynamicResource Bg.Window}"
        WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding #Root.CloseCommand}" />
    <KeyBinding Gesture="N" Command="{Binding NextCommand}" />
    <KeyBinding Gesture="H" Command="{Binding ShowAnswerCommand}" />
    <KeyBinding Gesture="R" Command="{Binding RestartCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Right" Width="300" Background="{DynamicResource Bg.Panel}" Padding="18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
          <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding LibraryText}" x:Name="LibraryText" />
          <Button HorizontalAlignment="Stretch" Content="{l:T Joseki.AddFromBoard}" Command="{Binding AddFromBoardCommand}" x:Name="AddButton"
                  ToolTip.Tip="{l:T Joseki.AddFromBoardTip}" />
          <Button HorizontalAlignment="Stretch" Content="{l:T Joseki.Import}" Command="{Binding ImportCommand}" x:Name="ImportButton" />
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding LineName}" FontSize="22" FontFamily="{DynamicResource Font.Title}" TextWrapping="Wrap" x:Name="LineName" />
          <TextBlock Classes="secondary" Text="{Binding BoxText}" FontSize="12" />
          <TextBlock Text="{Binding ProgressText}" x:Name="ProgressText" />
          <Border CornerRadius="6" Padding="10,8" Background="{DynamicResource Bg.Window}">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" x:Name="StatusText"
                       Classes.good="{Binding IsStatusGood}" Classes.bad="{Binding IsStatusBad}" />
          </Border>
          <TextBlock Classes="secondary" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" FontStyle="Italic" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{l:T Joseki.ShowAnswer}" Command="{Binding ShowAnswerCommand}" ToolTip.Tip="H" />
            <Button Content="{l:T Joseki.Restart}" Command="{Binding RestartCommand}" ToolTip.Tip="R" />
          </StackPanel>
          <Button Classes="accent" Content="{l:T Joseki.Next}" Command="{Binding NextCommand}" ToolTip.Tip="N" x:Name="NextButton" />
          <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{l:T Joseki.Help}" Margin="0,8,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Panel>
      <c:GoBoardControl x:Name="Board"
                        Margin="20"
                        Board="{Binding Board}"
                        BoardStyle="{DynamicResource Theme.Board}"
                        Animate="{DynamicResource Theme.Animations}"
                        LastMove="{Binding LastMove}"
                        Markers="{Binding Markers}"
                        HoverPoint="{Binding HoverPoint}"
                        GhostStone="{Binding GhostStone}"
                        PointClickedCommand="{Binding PlayCommand}" />
    </Panel>
  </DockPanel>
  <Window.Styles>
    <Style Selector="TextBlock.good">
      <Setter Property="Foreground" Value="#7FD08A" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="#F08A7A" />
    </Style>
  </Window.Styles>
</Window>
