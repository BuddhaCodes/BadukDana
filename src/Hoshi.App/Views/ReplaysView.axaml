<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Hoshi.App.Localization"
             xmlns:vm="using:Hoshi.App.ViewModels"
             x:Class="Hoshi.App.Views.ReplaysView"
             x:DataType="vm:ReplaysViewModel"
             x:Name="Root">
  <!-- The content of ReplaysWindow, shared with the phone layout (Hoshi.Android shows it as a page). -->
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="{l:T Replays.Title}" FontSize="22" FontFamily="{DynamicResource Font.Title}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{l:T Replays.Hint}" />
    </StackPanel>
    <TabControl SelectedIndex="{Binding Tab}" x:Name="LibraryTabs">
      <TabItem Header="{l:T Replays.GamesTab}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:T Replays.Delete}" Command="{Binding DeleteCommand}" x:Name="DeleteButton" />
            <Button Classes="accent" Content="{l:T Replays.Review}" Command="{Binding OpenCommand}" x:Name="OpenButton" />
          </StackPanel>
          <!-- Search: player, dates and result filter at once; the pattern comes from the main board. -->
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10" x:Name="SearchBar">
            <TextBox Text="{Binding PlayerFilter}" PlaceholderText="{l:T Replays.Player}" Width="170" Margin="0,0,8,6" x:Name="PlayerBox" />
            <CalendarDatePicker SelectedDate="{Binding FromDateValue}" PlaceholderText="{l:T Replays.From}" Width="140" Margin="0,0,8,6" x:Name="FromPicker" />
            <CalendarDatePicker SelectedDate="{Binding ToDateValue}" PlaceholderText="{l:T Replays.To}" Width="140" Margin="0,0,8,6" x:Name="ToPicker" />
            <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Width="150" Margin="0,0,8,6" x:Name="ResultBox" />
            <Button Content="{l:T Replays.UsePattern}" Command="{Binding UsePatternCommand}" ToolTip.Tip="{l:T Replays.UsePatternTip}" Margin="0,0,8,6" x:Name="PatternButton" />
            <Button Content="{l:T Replays.ClearFilters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,6" />
          </WrapPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" IsVisible="{Binding HasPattern}">
            <TextBlock Classes="secondary" Text="{Binding PatternText}" VerticalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsSearching}" VerticalAlignment="Center" />
            <Button Content="{l:T Replays.ClearPattern}" Command="{Binding ClearPatternCommand}" Padding="8,2" />
          </StackPanel>
          <Panel>
            <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" x:Name="ReplayList" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ReplayRow">
                  <StackPanel Margin="2,4" Spacing="2">
                    <TextBlock Text="{Binding Players}" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" Text="{Binding Details}" FontSize="12" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </TabItem>
      <!-- The notebook: every note of every game, filtered by category and text; a double tap opens its game at that move. -->
      <TabItem Header="{l:T Notebook.Tab}" x:Name="NotebookTab">
        <DockPanel DataContext="{Binding Notebook}" x:DataType="vm:NotebookViewModel">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Classes="accent" Content="{l:T Notebook.Open}" Command="{Binding OpenCommand}" x:Name="NotebookOpen" />
          </StackPanel>
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding Search}" PlaceholderText="{l:T Notebook.Search}" Width="220" Margin="0,0,8,6" x:Name="NotebookSearch" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="170" Margin="0,0,8,6" x:Name="NotebookCategory">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StudyCategoryOption">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Name}" /></StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{l:T Replays.ClearFilters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,6" />
            <TextBlock Classes="secondary" Text="{Binding CountText}" VerticalAlignment="Center" Margin="0,0,0,6" x:Name="NotebookCount" />
          </WrapPanel>
          <Panel>
            <TextBlock Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" x:Name="NotebookList" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NotebookRow">
                  <Grid ColumnDefinitions="Auto,*" Margin="2,4">
                    <Border Width="4" CornerRadius="2" Background="{Binding Colour}" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      <TextBlock Classes="secondary" FontSize="12" Text="{Binding Where}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
