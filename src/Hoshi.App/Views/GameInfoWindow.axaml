<Window Icon="/Assets/hoshi.ico"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Hoshi.App.Views"
        xmlns:l="using:Hoshi.App.Localization"
        xmlns:vm="using:Hoshi.App.ViewModels"
        xmlns:core="using:Hoshi.Core"
        x:Class="Hoshi.App.Views.GameInfoWindow"
        x:DataType="vm:GameInfoViewModel"
        Title="{l:T GameInfo.Title}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <v:GameInfoView x:Name="View" />
</Window>
