<!-- Design tokens. Source of truth: docs/DESIGN.md → "Paleta". -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Bg.Window.Color">#0B1026</Color>
  <Color x:Key="Bg.Panel.Color">#141A3A</Color>
  <Color x:Key="Bg.PanelAlt.Color">#1B2350</Color>
  <Color x:Key="Border.Subtle.Color">#2A315A</Color>
  <Color x:Key="Text.Primary.Color">#E9E6DA</Color>
  <Color x:Key="Text.Secondary.Color">#9AA0C3</Color>
  <Color x:Key="Accent.Color">#E8C36A</Color>
  <Color x:Key="Danger.Color">#D9534F</Color>
  <Color x:Key="Good.Color">#6CC47A</Color>
  <Color x:Key="Board.Wood.Color">#DCB35C</Color>
  <Color x:Key="Board.Line.Color">#CC1A1A1A</Color>

  <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Bg.Window.Color}" />
  <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource Bg.Panel.Color}" />
  <SolidColorBrush x:Key="Bg.PanelAlt" Color="{StaticResource Bg.PanelAlt.Color}" />
  <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
  <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
  <SolidColorBrush x:Key="Good" Color="{StaticResource Good.Color}" />
  <SolidColorBrush x:Key="Board.Wood" Color="{StaticResource Board.Wood.Color}" />
  <SolidColorBrush x:Key="Board.Line" Color="{StaticResource Board.Line.Color}" />

  <Color x:Key="Bg.Bar.Color">#0F1530</Color>
  <Color x:Key="Bg.Sidebar.Color">#0F1530</Color>
  <Color x:Key="Bg.Properties.Color">#141A3A</Color>
  <Color x:Key="Bg.EditBar.Color">#2E3F73</Color>
  <SolidColorBrush x:Key="Bg.Bar" Color="{StaticResource Bg.Bar.Color}" />
  <SolidColorBrush x:Key="Bg.Sidebar" Color="{StaticResource Bg.Sidebar.Color}" />
  <SolidColorBrush x:Key="Bg.Properties" Color="{StaticResource Bg.Properties.Color}" />
  <SolidColorBrush x:Key="Bg.EditBar" Color="{StaticResource Bg.EditBar.Color}" />

  <!-- Theme-driven keys: defaults here, replaced at start-up and on theme change by ThemeService. -->
  <SolidColorBrush x:Key="EditBar.Foreground" Color="#F1EEDF" />
  <SolidColorBrush x:Key="EditBar.Hover" Color="#3B4E8A" />
  <SolidColorBrush x:Key="Bg.Surround" Color="#0B1026" />
  <FontFamily x:Key="Font.UI">avares://Hoshi.App/Assets/Fonts/Manrope#Manrope</FontFamily>
  <FontFamily x:Key="Font.Title">avares://Hoshi.App/Assets/Fonts/Manrope#Manrope</FontFamily>
  <FontFamily x:Key="Font.Mono">avares://Hoshi.App/Assets/Fonts/JetBrainsMono#JetBrains Mono</FontFamily>
  <FontFamily x:Key="Font.Brand">avares://Hoshi.App/Assets/Fonts/ShipporiMincho#Shippori Mincho</FontFamily>
  <x:Double x:Key="Font.Size.Title">14</x:Double>

  <x:Double x:Key="BottomBar.Height">40</x:Double>
  <x:Double x:Key="Font.Size.Small">12</x:Double>
  <x:Double x:Key="Font.Size.Normal">13</x:Double>
</ResourceDictionary>
