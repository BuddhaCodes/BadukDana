<!-- Avalonia 12 draws window decorations itself where the platform asks for it (the caption buttons on Windows,
     border, shadow and resize grips on X11). Hoshi draws its own title bar and caption buttons (Controls/HoshiTitleBar),
     so this theme keeps only the frame: no title text, no title bar background, no caption buttons. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="HoshiWindowDecorations" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="0" />
    <Setter Property="DefaultFrameThickness" Value="1" />
    <Setter Property="DefaultShadowThickness" Value="8" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>
          <WindowDrawnDecorationsContent.Underlay>
            <Border BorderThickness="{TemplateBinding FrameThickness}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    IsHitTestVisible="False" />
          </WindowDrawnDecorationsContent.Underlay>
          <WindowDrawnDecorationsContent.Overlay>
            <Panel IsHitTestVisible="False" />
          </WindowDrawnDecorationsContent.Overlay>
        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
