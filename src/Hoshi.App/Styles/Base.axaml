<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
  </Style>

  <!-- Panels that appear (online panel, chat, edit bar, players) fade in. -->
  <Style Selector=":is(Control).appear[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Sabaki's bar: flat #292A2D, 40 px; the edit bar turns olive with dark text. -->
  <Style Selector="Border.bottom-bar">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
    <Setter Property="Background" Value="{DynamicResource Bg.Bar}" />
    <Setter Property="Height" Value="{DynamicResource BottomBar.Height}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Border.bottom-bar.edit">
    <Setter Property="Background" Value="{DynamicResource Bg.EditBar}" />
  </Style>
  <!-- Buttons inside sidebar panels: flat, like Sabaki's sidebar controls. -->
  <Style Selector="Border.panel-header Button">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
  </Style>

  <Style Selector="TextBlock.player">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Title}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
    <Setter Property="MaxWidth" Value="220" />
  </Style>

  <!-- Turn toggle between the player names (Sabaki's bar). -->
  <Style Selector="Border.turn-toggle">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="#E6E6E6" />
    <Setter Property="BorderBrush" Value="#111111" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.turn-knob">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.turn-knob.black">
    <Setter Property="Fill" Value="#1A1A1A" />
    <Setter Property="Stroke" Value="#000000" />
  </Style>
  <Style Selector="Ellipse.turn-knob.white">
    <Setter Property="Fill" Value="#FFFFFF" />
    <Setter Property="Stroke" Value="#9A9A9A" />
  </Style>

  <Style Selector="Border.game-header">
    <Setter Property="Padding" Value="14,12,14,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Analysis panel (sidebar). -->
  <Style Selector="Border.analysis">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ProgressBar.winrate">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="#141418" />
    <Setter Property="Background" Value="#F2F2EE" />
  </Style>
  <Style Selector="TextBlock.assessment">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.assessment.good"><Setter Property="Foreground" Value="#6CC47A" /></Style>
  <Style Selector="TextBlock.assessment.ok"><Setter Property="Foreground" Value="#A8C86A" /></Style>
  <Style Selector="TextBlock.assessment.warn"><Setter Property="Foreground" Value="#E6B450" /></Style>
  <Style Selector="TextBlock.assessment.bad"><Setter Property="Foreground" Value="#E0664F" /></Style>

  <!-- Toggle buttons in the bar (territory, analysis): accent underline when on. -->
  <Style Selector="Button.bar.toggle.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.bar.toggle.on">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.properties-header">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
    <Setter Property="Padding" Value="12,8,12,0" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
  </Style>
  <Style Selector="Button.bar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Button.bar /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.bar:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>
  <Style Selector="Button.bar">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="Button.bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="RadioButton.tool">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="3" Padding="9,3" MinHeight="26">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tool:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
  </Style>
  <Style Selector="RadioButton.tool:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- Online clocks: monospaced digits; amber when the player to move is under 10 s (DESIGN.md accent). -->
  <Style Selector="TextBlock.clock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.clock.low">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.panel-header">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
  </Style>

  <Style Selector="TextBox.comment">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox.comment:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.comment:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
  </Style>
  <!-- Edit bar overrides: last, so they win over the generic bar styles above. -->
  <Style Selector="Border.bottom-bar.edit Button.bar">
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
  </Style>
  <Style Selector="Border.bottom-bar.edit Button.bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.bottom-bar.edit RadioButton.tool">
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
  </Style>
  <Style Selector="Border.bottom-bar.edit RadioButton.tool:pointerover /template/ Border#bg, Border.bottom-bar.edit RadioButton.tool:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource EditBar.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditBar.Foreground}" />
  </Style>
  <Style Selector="Border.bottom-bar.edit Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditBar.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
  </Style>


  <!-- Preferences: theme cards. -->
  <Style Selector="Border.theme-card">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.theme-card:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-3px)" />
  </Style>
  <Style Selector="Border.theme-card.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
</Styles>
