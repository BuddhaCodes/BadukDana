<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Hoshi.App.Controls">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <!-- Hoshi's own title bar (Controls/HoshiTitleBar) above the content; the bar extends the window into the
         system title bar area itself and hides where the platform keeps its own. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <VisualLayerManager>
            <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">
              <c:HoshiTitleBar DockPanel.Dock="Top" />
              <ContentPresenter Name="PART_ContentPresenter"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </DockPanel>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Flyouts (sound panel) in the theme's colours instead of Fluent's grey. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Caption buttons of the title bar: flat, hover in the theme's panel colour, close turns red. -->
  <Style Selector="c|HoshiTitleBar Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="c|HoshiTitleBar Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
  </Style>
  <Style Selector="c|HoshiTitleBar Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
  </Style>
  <Style Selector="c|HoshiTitleBar Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>
  <Style Selector="c|HoshiTitleBar Button.caption.close:pointerover Path">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <!-- Panels that appear (online panel, chat, edit bar, players) fade in. -->
  <Style Selector=":is(Control).appear[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The header and the footer (redesign 2026-10): flat bars; in edit mode they take the theme's edit colour. -->
  <Style Selector="Border.bottom-bar">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
    <Setter Property="Background" Value="{DynamicResource Bg.Bar}" />
    <Setter Property="Height" Value="{DynamicResource BottomBar.Height}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <!-- Group titles in the phone menu. -->
  <Style Selector="TextBlock.menu-section">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="18,12,18,4" />
  </Style>

  <!-- Segmented tabs (the study panel's parts on phones): one big target each, the chosen one filled. -->
  <Style Selector="RadioButton.segment">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" CornerRadius="8" Background="Transparent" Padding="6,4">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#bg"><Setter Property="Background" Value="{DynamicResource Bg.Bar}" /></Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#bg"><Setter Property="Background" Value="{DynamicResource Bg.Panel}" /></Style>
  <Style Selector="RadioButton.segment:checked:pointerover /template/ Border#bg"><Setter Property="Background" Value="{DynamicResource Bg.Bar}" /></Style>

  <!-- Responsive bottom bar: "compact" keeps the icons only, "narrow" also hides the names (the turn toggle stays). -->
  <Style Selector="Border.bottom-bar.compact TextBlock.label"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.bottom-bar.compact Button.bar"><Setter Property="Padding" Value="7,3" /></Style>
  <Style Selector="Border.bottom-bar.compact TextBlock.player"><Setter Property="MaxWidth" Value="90" /></Style>
  <Style Selector="Border.bottom-bar.narrow TextBlock.player"><Setter Property="IsVisible" Value="False" /></Style>

  <Style Selector="Border.bottom-bar.edit">
    <Setter Property="Background" Value="{DynamicResource Bg.EditBar}" />
  </Style>
  <Style Selector="Border.app-header">
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.app-header Button.bar TextBlock.label"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.app-header.compact StackPanel#HeaderTitle"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.bottom-bar#BottomBar">
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Slider.moves"><Setter Property="MinWidth" Value="120" /></Style>
  <!-- Buttons inside sidebar panels: flat. -->
  <Style Selector="Border.panel-header Button">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
  </Style>

  <Style Selector="TextBlock.player">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Title}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
    <Setter Property="MaxWidth" Value="220" />
  </Style>

  <!-- Turn toggle between the player names (Sabaki's bar). -->
  <Style Selector="Border.turn-toggle">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="#E6E6E6" />
    <Setter Property="BorderBrush" Value="#111111" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.turn-knob">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.turn-knob.black">
    <Setter Property="Fill" Value="#1A1A1A" />
    <Setter Property="Stroke" Value="#000000" />
  </Style>
  <Style Selector="Ellipse.turn-knob.white">
    <Setter Property="Fill" Value="#FFFFFF" />
    <Setter Property="Stroke" Value="#9A9A9A" />
  </Style>

  <Style Selector="Border.game-header">
    <Setter Property="Padding" Value="14,12,14,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Analysis panel (sidebar). -->
  <Style Selector="Border.warmup">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Bg.Bar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.6" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.analysis">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ProgressBar.winrate">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="#141418" />
    <Setter Property="Background" Value="#F2F2EE" />
  </Style>
  <Style Selector="TextBlock.assessment">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.assessment.good"><Setter Property="Foreground" Value="{DynamicResource Good}" /></Style>
  <Style Selector="TextBlock.assessment.ok"><Setter Property="Foreground" Value="#A8C86A" /></Style>
  <Style Selector="TextBlock.assessment.warn"><Setter Property="Foreground" Value="#E6B450" /></Style>
  <Style Selector="TextBlock.assessment.bad"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>

  <!-- Toggle buttons in the bar (territory, analysis): accent underline when on. -->
  <Style Selector="Button.bar.toggle.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.bar.toggle.on">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.properties-header">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
    <Setter Property="Padding" Value="12,8,12,0" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
  </Style>
  <!-- A bar button whose feature is switched off (e.g. visual effects): dimmed. -->
  <Style Selector="Button.bar.dim">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Local game clock next to a player's name; red with ten seconds left. -->
  <Style Selector="Border.clock">
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
  </Style>
  <Style Selector="Border.clock > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Border.clock.low"><Setter Property="Background" Value="#B83A2E" /></Style>
  <Style Selector="Border.clock.low > TextBlock"><Setter Property="Foreground" Value="#FFF4EE" /></Style>

  <!-- Zen mode's way out: barely there until the pointer comes near. -->
  <!-- Leaving zen: a clear pill with an icon and the key, calm but always visible over any board. -->
  <Style Selector="Button.zen-exit">
    <Setter Property="Opacity" Value="0.82" />
    <Setter Property="Background" Value="{DynamicResource Bg.Bar}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.25" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.zen-exit /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 4 16 0 #66000000" />
  </Style>
  <Style Selector="Button.zen-exit:pointerover"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Button.zen-exit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.zen-exit.phone">
    <Setter Property="Opacity" Value="0.9" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>

  <Style Selector="Button.bar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Button.bar /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.bar:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>
  <Style Selector="Button.bar">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="Button.bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="RadioButton.tool">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="3" Padding="9,3" MinHeight="26">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tool:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
  </Style>
  <Style Selector="RadioButton.tool:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- Online clocks: monospaced digits; amber when the player to move is under 10 s (DESIGN.md accent). -->
  <Style Selector="TextBlock.clock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.clock.low">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.panel-header">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
  </Style>

  <Style Selector="TextBox.comment">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox.comment:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.comment:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Properties}" />
  </Style>
  <!-- Edit bar overrides: last, so they win over the generic bar styles above. -->
  <Style Selector="Border.bottom-bar.edit Button.bar">
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
  </Style>
  <Style Selector="Border.bottom-bar.edit Button.bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.bottom-bar.edit RadioButton.tool">
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
  </Style>
  <Style Selector="Border.bottom-bar.edit RadioButton.tool:pointerover /template/ Border#bg, Border.bottom-bar.edit RadioButton.tool:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource EditBar.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditBar.Foreground}" />
  </Style>
  <Style Selector="Border.bottom-bar.edit Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditBar.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource EditBar.Foreground}" />
  </Style>


  <!-- Preferences: theme cards. -->
  <Style Selector="Border.theme-card">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.theme-card:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-3px)" />
  </Style>
  <Style Selector="Border.theme-card.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Panels shared by the main window and the phone layout (chips, chat lines, results). -->
    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.chat-line">
      <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    </Style>
    <Style Selector="Border.chat-line.mine">
      <Setter Property="Background" Value="#33D9B45A" />
    </Style>
    <Style Selector="TextBlock.good">
      <Setter Property="Foreground" Value="#7FD08A" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="#F08A7A" />
    </Style>
    <Style Selector="ListBox.chips, ListBox.swatches">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.swatches ListBoxItem">
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

  <!-- Review inspector (redesign 2026-10). -->
  <Style Selector="ProgressBar.candidate">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="ProgressBar.candidate.best"><Setter Property="Foreground" Value="{DynamicResource Good}" /></Style>
  <Style Selector="TextBlock.candidate-move.best"><Setter Property="Foreground" Value="{DynamicResource Good}" /></Style>
  <Style Selector="Border.review-card">
    <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="Button.mistake"><Setter Property="Padding" Value="4,4" /><Setter Property="MinHeight" Value="28" /></Style>
  <Style Selector="Ellipse.mistake-stone"><Setter Property="Fill" Value="#141414" /><Setter Property="Stroke" Value="#9A9A9A" /><Setter Property="StrokeThickness" Value="1" /></Style>
  <Style Selector="Ellipse.mistake-stone.white"><Setter Property="Fill" Value="#F4F4F4" /></Style>
  <Style Selector="TextBlock.loss"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
  <Style Selector="TextBlock.loss.blunder"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
  <Style Selector="Button.danger-outline">
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.study-palette">
    <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BoxShadow" Value="0 14 36 -10 #B0000000" />
  </Style>
  <Style Selector="RadioButton.tool.palette"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /></Style>
  <Style Selector="Button.palette"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="34" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  <!-- The review's move list. -->
  <Style Selector="ListBox.move-list ListBoxItem">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.move-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
  </Style>
  <Style Selector="Button.move-cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.move">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.move.inaccuracy"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
  <Style Selector="TextBlock.move.mistake, TextBlock.move.blunder"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
  <Style Selector="TextBlock.move.blunder"><Setter Property="FontWeight" Value="Bold" /></Style>
  <Style Selector="TextBlock.move.current"><Setter Property="TextDecorations" Value="Underline" /></Style>
  <Style Selector="TextBlock.move-loss">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.quick-tile">
    <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
</Styles>
